+          set -euo pipefail
+          git uplink init
+
+      - name: Run company toolchain hook
+        uses: $/.github/actions/uplink-toolchain-hook
+        with:
+          token: ${{ secrets.GITHUB_TOKEN }}
+
+      # No token in this step: git uplink refuses to run preflight.sh in a
+      # CI job step that holds one.
+      - name: Run preflight.sh
+        id: run
+        env:
+          PATCH_ID: ${{ inputs.patch_id }}
+        run: |
+          report=$(git uplink preflight "$PATCH_ID" --json) || true
+          if ! jq -e . >/dev/null 2>&1 <<<"$report"; then
+            echo "git uplink printed no preflight result"
+            exit 1
+          fi
+          echo "report=$(jq -c . <<<"$report")" >> "$GITHUB_OUTPUT"
+
+  submit:
+    name: Approve to-upstream environment and submit
+    needs: [packet, preflight]
+    if: github.ref == 'refs/heads/main'
+    runs-on: ubuntu-latest
+    permissions:
+      contents: write
+      deployments: write
+    environment:
+      name: to-upstream
+      url: ${{ github.server_url }}/${{ github.repository }}/blob/${{ needs.packet.outputs.state_sha }}/.uplink/reports/${{ inputs.patch_id }}/assessment.md
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          fetch-depth: 0
+          persist-credentials: false
+          ref: main
+      - uses: $/.github/actions/install-git-uplink
+        with:
+          repo: ${{ vars.UPLINK_SRC }}
+          version: ${{ vars.UPLINK_VERSION }}
+          signer: ${{ vars.UPLINK_SIGNER }}
+          token: ${{ secrets.GITHUB_TOKEN }}
+      - name: Read upstream and contrib from the queue
+        id: queue
+        env:
+          UPLINK_INTERNAL_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: |
+          set -euo pipefail
+          config=$(git uplink init --json)
+          jq -r '
+            def owner_repo:
+              sub("\\.git$";"") | sub("/$";"")
+              | capture("github\\.com[:/](?<owner>[^/]+)/(?<repo>.+)$")
+              // error("Could not parse GitHub owner/repo from queue URL");
