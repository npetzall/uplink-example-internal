+          # It shows as Verified only when UPLINK_CONTRIB_* is a GitHub App token.
+          contrib_json=$(CONTRIB_COMMIT=$(jq -c .contribCommit <<<"$submit_json") \
+            CONTRIB_REPO="$HEAD_REPO" python3 .github/uplink/contrib_commit.py)
+          printf 'Contrib commit %s (verified: %s)\n' \
+            "$(jq -r .sha <<<"$contrib_json")" "$(jq -r .verified <<<"$contrib_json")" >> "$GITHUB_STEP_SUMMARY"
+
+          repo=$(jq -r '.gh.prCreate.repo // empty' <<<"$submit_json")
+          head=$(jq -r '.gh.prCreate.head // empty' <<<"$submit_json")
+          if [ -n "$repo" ] && [ -n "$head" ]; then
+            parent_owner=${repo%%/*}
+            head_owner=${head%%:*}
+            parent_lc=$(printf '%s' "$parent_owner" | tr '[:upper:]' '[:lower:]')
+            head_lc=$(printf '%s' "$head_owner" | tr '[:upper:]' '[:lower:]')
+            if [ "$parent_lc" = "$head_lc" ]; then
+              account_type=$(gh api "users/${parent_owner}" --jq '.type // empty' || true)
+              if [ "$account_type" = "User" ]; then
+                echo "Upstream and the contribution fork cannot both be under a user account. Fork into the same organization, or use a different owner with a machine user classic PAT."
+                exit 1
+              fi
+            else
+              case "$GH_TOKEN" in
+                ghp_*) ;;
+                *)
+                  echo "Upstream and the contribution fork are different owners. Fine-grained PATs and GitHub App tokens cannot open this pull request. Use a machine user with a classic PAT."
+                  exit 1
+                  ;;
+              esac
+            fi
+          fi
+          url=$(jq -r '.existingPr.url // empty' <<<"$submit_json")
+          if [ -z "$url" ] && [ -n "$repo" ] && [ -n "$head" ]; then
+            url=$(gh api --method GET "/repos/${repo}/pulls" -f state=open -f head="$head" --jq '.[0].html_url // empty')
+          fi
+          if [ -z "$url" ]; then
+            title=$(jq -r .gh.prCreate.title <<<"$submit_json")
+            body_file=$(jq -r .gh.prCreate.bodyFile <<<"$submit_json")
+            base=$(jq -r .gh.prCreate.base <<<"$submit_json")
+            branch=$(jq -r '.branch // empty' <<<"$submit_json")
+            url=$(gh api --method POST \
+              -H "Accept: application/vnd.github+json" \
+              -H "X-GitHub-Api-Version: 2022-11-28" \
+              "/repos/${repo}/pulls" \
+              -f title="$title" \
+              -F "body=@${body_file}" \
+              -f head="$branch" \
+              -f head_repo="$HEAD_REPO" \
+              -f base="$base" \
+              -F maintainer_can_modify=false \
+              --jq .html_url)
+          fi
+          git uplink submitted "$PATCH_ID" --pr-url "$url"
