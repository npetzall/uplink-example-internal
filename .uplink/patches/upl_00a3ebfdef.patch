index 0000000000000000000000000000000000000000..85985cae9b71a25c084ed5d99956c661133a4f01
--- /dev/null
+++ b/.github/workflows/uplink-resolve.yml
@@ -0,0 +1,292 @@
+# GitHub forge pack (`git uplink init --forge github`).
+# Installs git-uplink from a GitHub release.
+# Empty UPLINK_*_AUTH defaults to app.
+#
+# Runs when the gated conflict PR is merged into uplink/conflict/<id>.
+# YAML is loaded from the default branch so *-work cannot replace this sidecar.
+# git uplink resolve amends the patch, rebuilds company main, and
+# deletes the protected base plus -work branch. If the patch was already
+# submitted, this job dispatches Uplink submit to export it onto the new
+# upstream. A resolution that adds or removes other lines than the last
+# approval covered makes the patch amended, and that run asks for a delta
+# approval. One that leaves those lines as approved leaves it submitted: the
+# run only exports it again.
+# If rebuild stops on a later patch, it publishes that conflict the same
+# way sync does. That includes a patch preflight.sh fails on in the rebuilt
+# tree, found with git bisect, which can be the resolved patch again.
+# With repository variable UPLINK_AUTO_SUBMIT set to `true`, it dispatches
+# Uplink submit for the resolved patch when it is queued again, and for a
+# queued patch whose last unmerged upstream dependency the rebuild marked
+# merged.
+name: Uplink resolve
+
+on: # zizmor: ignore[dangerous-triggers] YAML from default branch; gated tree is data
+  pull_request_target:
+    types: [closed]
+    branches:
+      - "uplink/conflict/**"
+
+concurrency:
+  group: uplink-mutate
+  queue: max
+
+permissions: {}
+
+jobs:
+  # preflight.sh builds and runs product code (public upstream's included),
+  # so it runs in this job: read-only token, no App token, no Environment,
+  # no credentials in the checkout. The job that holds the write tokens
+  # takes the result and never runs the script.
+  preflight:
+    name: Preflight the rebuild (no credentials)
+    if: github.event.pull_request.merged == true && !endsWith(github.event.pull_request.base.ref, '-work')
+    runs-on: ubuntu-latest
+    permissions:
+      contents: read
+    outputs:
+      report: ${{ steps.run.outputs.report }}
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          fetch-depth: 0
+          persist-credentials: false
+          ref: ${{ github.event.pull_request.base.ref }}
+
+      - uses: $/.github/actions/install-git-uplink
+        with:
+          repo: ${{ vars.UPLINK_SRC }}
+          version: ${{ vars.UPLINK_VERSION }}
+          signer: ${{ vars.UPLINK_SIGNER }}
+          token: ${{ secrets.GITHUB_TOKEN }}
+
+      - name: Fetch what preflight reads
+        env:
+          UPLINK_INTERNAL_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: |
+          set -euo pipefail
+          git uplink init
+
+      - name: Run company toolchain hook
+        uses: $/.github/actions/uplink-toolchain-hook
+        with:
+          token: ${{ secrets.GITHUB_TOKEN }}
+
+      # No token in this step: git uplink refuses to run preflight.sh in a
+      # CI job step that holds one. When the script fails on the rebuilt
+      # tree, git bisect runs it here too, to find the patch.
+      - name: Run preflight.sh
+        id: run
+        env:
+          BASE_REF: ${{ github.event.pull_request.base.ref }}
+        run: |
+          id="${BASE_REF#uplink/conflict/}"
+          report=$(git uplink resolve "$id" --preflight-only) || true
+          if ! jq -e . >/dev/null 2>&1 <<<"$report"; then
+            echo "git uplink printed no preflight result"
+            exit 1
+          fi
+          echo "report=$(jq -c . <<<"$report")" >> "$GITHUB_OUTPUT"
+
+  resolve:
+    needs: preflight
+    if: github.event.pull_request.merged == true && !endsWith(github.event.pull_request.base.ref, '-work')
+    runs-on: ubuntu-latest
+    permissions:
+      contents: write
+      pull-requests: write
+      actions: write
+    steps:
+      - uses: $/.github/actions/install-git-uplink
+        with:
+          repo: ${{ vars.UPLINK_SRC }}
+          version: ${{ vars.UPLINK_VERSION }}
+          signer: ${{ vars.UPLINK_SIGNER }}
+          token: ${{ secrets.GITHUB_TOKEN }}
+
+      - name: Mint internal GitHub App token
+        id: internal-app
+        if: ${{ vars.UPLINK_INTERNAL_AUTH != 'pat' }}
+        uses: actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1 # v3.2.0
+        with:
+          app-id: ${{ secrets.UPLINK_INTERNAL_APP_ID }}
+          private-key: ${{ secrets.UPLINK_INTERNAL_APP_PRIVATE_KEY }}
+          owner: ${{ github.repository_owner }}
+          repositories: ${{ github.event.repository.name }}
+          permission-contents: write
+          permission-workflows: write
+          permission-pull-requests: write
+
+      - name: Read upstream and contrib from the queue
+        id: queue
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: |
+          set -euo pipefail
+          content=$(gh api "repos/${GITHUB_REPOSITORY}/contents/.uplink/queue.json?ref=uplink%2Fstate" --jq .content)
+          queue=$(printf '%s' "$content" | tr -d '\n' | base64 -d)
+          parse_owner_repo() {
+            local url=$1 owner repo
+            if [[ "$url" =~ github.com[:/]([^/]+)/(.+)$ ]]; then
+              owner=${BASH_REMATCH[1]}
+              repo=${BASH_REMATCH[2]}
+              repo=${repo%.git}
+              repo=${repo%/}
+              printf '%s\n%s\n' "$owner" "$repo"
+              return 0
+            fi
+            echo "Could not parse GitHub owner/repo from queue URL" >&2
+            return 1
+          }
+          upstream_url=$(jq -r '.config.upstreamUrl // empty' <<<"$queue")
+          contrib_url=$(jq -r '.config.contribUrl // empty' <<<"$queue")
+          if [ -z "$upstream_url" ] || [ -z "$contrib_url" ]; then
+            echo "queue.json is missing upstreamUrl or contribUrl" >&2
+            exit 1
+          fi
+          mapfile -t upstream < <(parse_owner_repo "$upstream_url")
+          mapfile -t contrib < <(parse_owner_repo "$contrib_url")
+          same_owner=false
+          upstream_lc=$(printf '%s' "${upstream[0]}" | tr '[:upper:]' '[:lower:]')
+          contrib_lc=$(printf '%s' "${contrib[0]}" | tr '[:upper:]' '[:lower:]')
+          if [ "$upstream_lc" = "$contrib_lc" ]; then
+            same_owner=true
+          fi
+          {
+            echo "upstream_owner=${upstream[0]}"
+            echo "upstream_repo=${upstream[1]}"
+            echo "contrib_owner=${contrib[0]}"
+            echo "contrib_repo=${contrib[1]}"
+            echo "same_owner=${same_owner}"
+          } >> "$GITHUB_OUTPUT"
+
+      - name: Mint upstream GitHub App token
+        id: upstream-app
+        if: ${{ vars.UPLINK_UPSTREAM_AUTH != 'pat' }}
+        uses: actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1 # v3.2.0
+        with:
+          app-id: ${{ secrets.UPLINK_UPSTREAM_APP_ID }}
+          private-key: ${{ secrets.UPLINK_UPSTREAM_APP_PRIVATE_KEY }}
+          owner: ${{ steps.queue.outputs.upstream_owner }}
+          repositories: ${{ steps.queue.outputs.upstream_repo }}
+          permission-contents: read
+
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          fetch-depth: 0
+          persist-credentials: true
+          ref: ${{ github.event.pull_request.base.ref }}
+          token: ${{ steps.internal-app.outputs.token || secrets.UPLINK_INTERNAL_TOKEN }}
+
+      - name: Resolve patch and rebuild main
+        id: resolve
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          GH_REPO: ${{ github.repository }}
+          UPLINK_INTERNAL_TOKEN: ${{ steps.internal-app.outputs.token || secrets.UPLINK_INTERNAL_TOKEN }}
+          UPLINK_UPSTREAM_TOKEN: ${{ steps.upstream-app.outputs.token || secrets.UPLINK_UPSTREAM_TOKEN }}
+          BASE_REF: ${{ github.event.pull_request.base.ref }}
+          PREFLIGHT_REPORT: ${{ needs.preflight.outputs.report }}
+        run: |
+          git uplink init
+          printf '%s' "$PREFLIGHT_REPORT" > "$RUNNER_TEMP/uplink-preflight.json"
+          id="${BASE_REF#uplink/conflict/}"
+          if [ -z "$id" ] || [ "$id" = "$BASE_REF" ] || [[ "$id" == *-work ]]; then
+            echo "Could not parse patch id from $BASE_REF"
+            exit 1
+          fi
+
+          main_before=$(git rev-parse origin/main)
+
+          resolve_json=$(git uplink resolve "$id" \
+            --preflight-result "$RUNNER_TEMP/uplink-preflight.json")
+
+          head=$(git rev-parse --abbrev-ref HEAD)
+          if [ "$head" != "main" ]; then
+            echo "HEAD is ${head}, not main; refusing to push"
+            exit 1
+          fi
+
+          git push origin uplink/state
+          echo "ready_to_submit=$(jq -c '.readyToSubmit // []' <<<"$resolve_json")" >> "$GITHUB_OUTPUT"
+          main_after=$(git rev-parse HEAD)
+          if [ "$main_after" != "$main_before" ]; then
+            git push origin main --force
+          fi
+
+          status=$(jq -r '.status // empty' <<<"$resolve_json")
+          if [ -z "$status" ]; then
+            queue_json=$(git show uplink/state:.uplink/queue.json 2>/dev/null || cat .uplink/queue.json)
+            status=$(printf '%s\n' "$queue_json" | jq -r --arg id "$id" '(.tooling, .upstream[], .internal[]) | select(. != null and .id==$id) | .status')
+          fi
+          # amended: IP approves the delta. submitted: the last approval still
+          # covers the patch, and the public PR needs the new export.
+          if [ "$status" = "amended" ] || [ "$status" = "submitted" ]; then
+            runs=$(gh run list --workflow="Uplink submit" --limit 20 --json databaseId,displayTitle,status 2>/dev/null || echo '[]')
+            echo "$runs" | jq -r --arg title "Uplink submit $id" \
+              '.[] | select((.displayTitle // "") == $title and (.status == "waiting" or .status == "in_progress")) | .databaseId' \
+              | while read -r run_id; do
+              if [ -n "$run_id" ]; then
+                gh run cancel "$run_id" || true
+              fi
+            done
+            gh workflow run "Uplink submit" --ref main -f "patch_id=$id"
+          fi
+
+          if jq -e '.conflict != null' <<<"$resolve_json" >/dev/null; then
+            conflict_id=$(jq -r '.conflict.id // empty' <<<"$resolve_json")
+            conflict_branch=$(jq -r '.conflict.branch // empty' <<<"$resolve_json")
+            work_branch=$(jq -r '.conflict.workBranch // empty' <<<"$resolve_json")
+            if [ -z "$conflict_id" ] || [ "$conflict_id" = "null" ]; then
+              echo "resolve recorded a follow-on conflict but no conflict patch id was present"
+              git push origin --delete "uplink/conflict/${id}" || true
+              git push origin --delete "uplink/conflict/${id}-work" || true
+              exit 1
+            fi
+            if git show-ref --verify --quiet "refs/heads/${conflict_branch}"; then
+              git push origin "refs/heads/${conflict_branch}:refs/heads/${conflict_branch}" --force
+            fi
+            if [ -n "$work_branch" ] && git show-ref --verify --quiet "refs/heads/${work_branch}"; then
+              git push origin "refs/heads/${work_branch}:refs/heads/${work_branch}" --force
+            fi
+
+            title=$(jq -r '.gh.prCreate.title' <<<"$resolve_json")
+            body_file=$(jq -r '.gh.prCreate.bodyFile' <<<"$resolve_json")
+            head=$(jq -r '.gh.prCreate.head' <<<"$resolve_json")
+            base=$(jq -r '.gh.prCreate.base' <<<"$resolve_json")
+            existing=$(gh pr list --head "$head" --base "$base" --state open --json url --jq '.[0].url')
+            if [ -z "$existing" ]; then
+              gh label create uplink:conflict --description "Uplink sync conflict; resolve via the gated work PR" --color B60205 || true
+              # The internal bot opens the PR: GITHUB_TOKEN may not create PRs, and a
+              # bot-opened PR triggers the Uplink gate check. The Actions token labels it.
+              url=$(GH_TOKEN="$UPLINK_INTERNAL_TOKEN" gh pr create --title "$title" --base "$base" --head "$head" --body-file "$body_file")
+              gh pr edit "$url" --add-label uplink:conflict
+            else
+              url="$existing"
+            fi
+            git uplink gated "$conflict_id" --pr-url "$url"
+            # preflight.sh still fails on the resolved patch: its branches
+            # were just published again for the next PR.
+            if [ "$conflict_id" = "$id" ]; then
+              exit 0
+            fi
+          fi
+
+          git push origin --delete "uplink/conflict/${id}" || true
+          git push origin --delete "uplink/conflict/${id}-work" || true
+
+      - name: Dispatch Uplink submit for patches that became ready
+        if: ${{ vars.UPLINK_AUTO_SUBMIT == 'true' && steps.resolve.outputs.ready_to_submit != '' && steps.resolve.outputs.ready_to_submit != '[]' }}
+        uses: $/.github/actions/uplink-dispatch-submit
+        with:
+          patch-ids: ${{ steps.resolve.outputs.ready_to_submit }}
+          token: ${{ secrets.GITHUB_TOKEN }}
+
+      # A rebuild writes every commit of main again. Tell the open pull
+      # requests it left behind how to rebase; a failure here is not a
+      # failure of the job.
+      - name: Tell open pull requests about a rebuilt main
+        continue-on-error: true
+        uses: $/.github/actions/uplink-rebase-comment
+        with:
+          token: ${{ secrets.GITHUB_TOKEN }}
+          auto-rebase: ${{ vars.UPLINK_AUTO_REBASE }}
