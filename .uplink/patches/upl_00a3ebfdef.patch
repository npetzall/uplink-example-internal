+            | "upstream_owner=\($up.owner)",
+              "upstream_repo=\($up.repo)",
+              "contrib_owner=\($co.owner)",
+              "contrib_repo=\($co.repo)",
+              "same_owner=\(if ($up.owner | ascii_downcase) == ($co.owner | ascii_downcase) then "true" else "false" end)"
+          ' <<<"$config" >> "$GITHUB_OUTPUT"
+
+      - name: Mint contrib GitHub App token
+        id: contrib-app
