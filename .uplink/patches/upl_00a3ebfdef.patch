+        uses: actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1 # v3.2.0
+        with:
+          app-id: ${{ secrets.UPLINK_CONTRIB_APP_ID }}
+          private-key: ${{ secrets.UPLINK_CONTRIB_APP_PRIVATE_KEY }}
+          owner: ${{ steps.queue.outputs.contrib_owner }}
+          repositories: ${{ steps.queue.outputs.contrib_repo }}
+          permission-contents: write
+
+      - name: Mint upstream GitHub App token
+        id: upstream-app
+        if: ${{ vars.UPLINK_UPSTREAM_AUTH != 'pat' && steps.queue.outputs.same_owner == 'true' }}
+        uses: actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1 # v3.2.0
+        with:
+          app-id: ${{ secrets.UPLINK_UPSTREAM_APP_ID }}
+          private-key: ${{ secrets.UPLINK_UPSTREAM_APP_PRIVATE_KEY }}
+          owner: ${{ steps.queue.outputs.upstream_owner }}
+          repositories: ${{ steps.queue.outputs.upstream_repo }},${{ steps.queue.outputs.contrib_repo }}
+          permission-contents: read
+          permission-pull-requests: write
+
+      - name: Record approval, export, and record the public PR
+        env:
+          GH_TOKEN: ${{ steps.upstream-app.outputs.token || secrets.UPLINK_UPSTREAM_TOKEN }}
+          UPLINK_INTERNAL_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          UPLINK_CONTRIB_TOKEN: ${{ steps.contrib-app.outputs.token || secrets.UPLINK_CONTRIB_TOKEN }}
+          UPLINK_TO_UPSTREAM_ENVIRONMENT: to-upstream
+          PATCH_ID: ${{ inputs.patch_id }}
+          REVIEW_TOKEN: ${{ needs.packet.outputs.review_token }}
+          HEAD_REPO: ${{ steps.queue.outputs.contrib_owner }}/${{ steps.queue.outputs.contrib_repo }}
+          PREFLIGHT_REPORT: ${{ needs.preflight.outputs.report }}
+        run: |
+          printf '%s' "$PREFLIGHT_REPORT" > "$RUNNER_TEMP/uplink-preflight.json"
+          if [ -z "$REVIEW_TOKEN" ]; then
+            echo "The packet job recorded no review token; not approving."
+            exit 1
+          fi
+          # Approves only the content the packet of this run showed.
+          receipt=$(git uplink approve "$PATCH_ID" --reviewed "$REVIEW_TOKEN")
+          printf '%s\n' "$receipt" >> "$GITHUB_STEP_SUMMARY"
+          # The result is for one tree. If uplink/upstream or uplink/hooks moved
+          # while this job waited for approval, submit stops; dispatch again.
+          submit_json=$(git uplink submit "$PATCH_ID" --preflight-result "$RUNNER_TEMP/uplink-preflight.json")
