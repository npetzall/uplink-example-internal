index 0000000000000000000000000000000000000000..3d98f5e1cdf2a8ad801f6c5574f959ff1b4ec0a0
--- /dev/null
+++ b/.github/workflows/uplink-assessment-hook.yml
@@ -0,0 +1,48 @@
+# Placeholder for the company assessment hook. Do not edit it here.
+# GitHub only dispatches a workflow whose file exists on the default branch,
+# so this file lets Uplink run the real hook with --ref uplink/hooks.
+#
+# Run it by hand from main. It prints assessment-hook.md from the orphan
+# branch uplink/hooks, which git uplink init creates. It writes nothing.
+name: Uplink assessment hook
+
+on:
+  workflow_dispatch:
+    inputs:
+      caller_run_id:
+        description: Caller run id (it holds the assessment package, and matches this hook run)
+        required: true
+        type: string
+
+permissions: {}
+
+jobs:
+  guide:
+    name: Show the assessment hook guide
+    if: github.ref == 'refs/heads/main'
+    runs-on: ubuntu-latest
+    permissions:
+      contents: read
+    steps:
+      - name: Print assessment-hook.md from uplink/hooks
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          GH_REPO: ${{ github.repository }}
+        run: |
+          set -euo pipefail
+          if ! guide=$(gh api -H "Accept: application/vnd.github.raw+json" \
+            "repos/${GH_REPO}/contents/assessment-hook.md?ref=uplink%2Fhooks" 2>&1); then
+            if grep -q "HTTP 404" <<<"$guide"; then
+              {
+                echo "> [!WARNING]"
+                echo "> \`uplink/hooks\` or its \`assessment-hook.md\` is missing on origin."
+                echo "> Run \`git uplink init --upgrade\`, then \`git uplink push\`."
+                echo "> \`git uplink doctor\` checks the branch (refs/heads/uplink/hooks)."
+              } >> "$GITHUB_STEP_SUMMARY"
+              echo "::error title=uplink/hooks missing::Run git uplink init --upgrade, then git uplink push."
+              exit 1
+            fi
+            echo "::error title=Could not read uplink/hooks::${guide}"
+            exit 1
+          fi
+          printf '%s\n' "$guide" >> "$GITHUB_STEP_SUMMARY"
diff --git a/.github/workflows/uplink-gate.yml b/.github/workflows/uplink-gate.yml
new file mode 100644
index 0000000000000000000000000000000000000000..41ba9f01bc15ecb7885fc111d112b6c0626ad1fb
--- /dev/null
+++ b/.github/workflows/uplink-gate.yml
@@ -0,0 +1,179 @@
+# GitHub forge pack (`git uplink init --forge github`).
+# Required check on PRs into protected uplink bases. These PRs are not imports.
+# YAML is loaded from the default branch so *-work cannot replace this sidecar.
+# Origin fetch uses the Actions token as UPLINK_INTERNAL_TOKEN (contents: read).
+# The shell git fetch of the protected base uses that token for one command.
+# The step that assesses and runs preflight.sh has no token: the script
+# builds and runs the gated tree. When it ran preflight.sh, a separate job
+# writes the verdict to one PR comment, on every run and updated in place.
+name: Uplink gate
+
+on: # zizmor: ignore[dangerous-triggers] YAML from default branch; gated tree is data; contents: read; persist-credentials: false
+  pull_request_target:
+    types: [opened, synchronize, reopened, edited, ready_for_review]
+    branches:
+      - "uplink/conflict/**"
+      - "uplink/transfer-to-upstream/**"
+      - "uplink/transfer-to-internal/**"
+      - "uplink/amend/**"
+
+concurrency:
+  group: uplink-gate-${{ github.event.pull_request.number }}
+  cancel-in-progress: true
+
+permissions:
+  contents: read
+
+jobs:
+  validate:
+    name: Uplink gate
+    if: ${{ !endsWith(github.event.pull_request.base.ref, '-work') }}
+    runs-on: ubuntu-latest
+    outputs:
+      preflight: ${{ steps.run.outputs.preflight }}
+      report: ${{ steps.run.outputs.report }}
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          fetch-depth: 0
+          persist-credentials: false
+          ref: ${{ github.event.pull_request.head.sha }}
+
+      - uses: $/.github/actions/install-git-uplink
+        with:
+          repo: ${{ vars.UPLINK_SRC }}
+          version: ${{ vars.UPLINK_VERSION }}
+          signer: ${{ vars.UPLINK_SIGNER }}
+          token: ${{ secrets.GITHUB_TOKEN }}
+
+      - name: Fetch the base and check the changed files
+        env:
+          UPLINK_INTERNAL_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          BASE_REF: ${{ github.event.pull_request.base.ref }}
+          FROM_SHA: ${{ github.event.pull_request.base.sha }}
+          HEAD_SHA: ${{ github.event.pull_request.head.sha }}
+        run: |
+          git uplink init
+          # Depth 2 keeps the base's parent: an amend assesses from it.
+          auth=$(printf 'x-access-token:%s' "$UPLINK_INTERNAL_TOKEN" | base64 -w0)
+          git \
+            -c "http.${GITHUB_SERVER_URL}/.extraheader=" \
+            -c "http.${GITHUB_SERVER_URL}/.extraheader=Authorization: Basic ${auth}" \
+            fetch origin "$BASE_REF" --depth=2
+          if git diff --name-only "$FROM_SHA" "$HEAD_SHA" | grep -E \
+            -q '^(\.github/workflows/uplink-.*\.yml|\.github/actions/(install-git-uplink|uplink-[^/]*)/|\.github/uplink/)'; then
+            echo "Gated PRs must not change Uplink pack files (uplink-*.yml, install-git-uplink, uplink-* actions, .github/uplink/)."
+            echo "Edit product workflows as needed. Change sidecars on main via git uplink init --upgrade."
+            exit 1
+          fi
+          # .uplink/ is Uplink's own state. It is not scanned by the
+          # assessment, so it must not be part of gated work.
+          if git diff --name-only "$FROM_SHA" "$HEAD_SHA" | grep -q '^\.uplink/'; then
+            echo "Gated PRs must not change files under .uplink/."
+            exit 1
+          fi
+          if git grep -I -l '^<<<<<<<' -- . ':!.uplink' >/dev/null 2>&1; then
+            echo "Conflict markers still present; remove them before merge."
+            exit 1
+          fi
+
+      - name: Run company toolchain hook
+        uses: $/.github/actions/uplink-toolchain-hook
+        with:
+          token: ${{ secrets.GITHUB_TOKEN }}
+
+      # No token in this step: git uplink refuses to run preflight.sh in a
+      # CI job step that holds one.
+      - name: Validate gated work
+        id: run
+        env:
+          BASE_REF: ${{ github.event.pull_request.base.ref }}
+          FROM_SHA: ${{ github.event.pull_request.base.sha }}
+          HEAD_SHA: ${{ github.event.pull_request.head.sha }}
+          TITLE: ${{ github.event.pull_request.title }}
+          BODY: ${{ github.event.pull_request.body }}
+        run: |
+          # Internal-only patches never leave the company: skip the upstream
+          # assessment and run only the preflight script, as for
+          # transfer-to-internal. If the queue cannot be read, assess.
+          is_internal() {
+            local queue
+            queue=$(git show uplink/state:.uplink/queue.json 2>/dev/null || cat .uplink/queue.json 2>/dev/null) || return 1
+            jq -e --arg id "$1" 'any(.internal[]?; .id == $id)' <<<"$queue" >/dev/null
+          }
+          # The result goes to the comment job; the next step fails on it.
+          # preflight.sh prints to this log (stderr).
+          run_preflight() {
+            local report
+            echo "preflight=true" >> "$GITHUB_OUTPUT"
+            report=$(git uplink preflight --json "$@") || true
+            if ! jq -e . >/dev/null 2>&1 <<<"$report"; then
+              echo "git uplink printed no preflight result"
+              exit 1
+            fi
+            echo "report=$(jq -c . <<<"$report")" >> "$GITHUB_OUTPUT"
+          }
+          if [[ "$BASE_REF" == uplink/conflict/* ]] && is_internal "${BASE_REF#uplink/conflict/}"; then
+            run_preflight --command-only
+          elif [[ "$BASE_REF" == uplink/amend/* ]] && is_internal "${BASE_REF#uplink/amend/}"; then
+            run_preflight --command-only
+          elif [[ "$BASE_REF" == uplink/conflict/* ]]; then
+            # The resolution is new code: assess it with the patch's stored
+            # message, as resolve will after merge. A failure blocks the merge.
+            git uplink assess --patch "${BASE_REF#uplink/conflict/}" \
+              --from "$FROM_SHA" \
+              --head "$HEAD_SHA"
+          elif [[ "$BASE_REF" == uplink/amend/* ]]; then
+            # The PR title and description become the patch message on merge.
+            # Assess the whole amended patch (base^ is the commit before it).
+            {
+              printf '%s\n\n' "$TITLE"
+              printf '%s\n' "${BODY:-}"
+            } > /tmp/uplink-msg.txt
+            git uplink assess --patch "${BASE_REF#uplink/amend/}" \
+              --title "$TITLE" \
+              --message-file /tmp/uplink-msg.txt \
+              --from "${FROM_SHA}^" \
+              --head "$HEAD_SHA"
+          elif [[ "$BASE_REF" == uplink/transfer-to-upstream/* ]]; then
+            {
+              printf '%s\n\n' "$TITLE"
+              printf '%s\n' "${BODY:-}"
+            } > /tmp/uplink-msg.txt
+            run_preflight \
+              --title "$TITLE" \
+              --message-file /tmp/uplink-msg.txt \
+              --from "$FROM_SHA" \
+              --head "$HEAD_SHA"
+          elif [[ "$BASE_REF" == uplink/transfer-to-internal/* ]]; then
+            run_preflight --command-only
+          fi
+
+      - name: Fail when preflight did not pass
+        if: ${{ steps.run.outputs.report != '' }}
+        env:
+          REPORT: ${{ steps.run.outputs.report }}
+        run: jq -e '.ok == true' <<<"$REPORT" > /dev/null
+
+  # Never runs preflight.sh. The action is the default branch's copy, not the
+  # gated tree's.
+  preflight-comment:
+    name: Uplink gate preflight comment
+    needs: validate
+    if: ${{ always() && needs.validate.outputs.preflight == 'true' && needs.validate.result != 'cancelled' }}
+    runs-on: ubuntu-latest
+    permissions:
+      contents: read
+      pull-requests: write
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+          ref: ${{ github.event.repository.default_branch }}
+          sparse-checkout: .github/actions
+
+      - uses: $/.github/actions/uplink-preflight-comment
+        with:
+          report: ${{ needs.validate.outputs.report }}
+          pr-number: ${{ github.event.pull_request.number }}
+          token: ${{ secrets.GITHUB_TOKEN }}
diff --git a/.github/workflows/uplink-import.yml b/.github/workflows/uplink-import.yml
new file mode 100644
index 0000000000000000000000000000000000000000..7deb9878f2b33055a4ea26e4b67d0048f5596c7e
--- /dev/null
+++ b/.github/workflows/uplink-import.yml
@@ -0,0 +1,301 @@
+# GitHub forge pack (`git uplink init --forge github`).
+# Installs git-uplink from a GitHub release.
+# Empty UPLINK_*_AUTH defaults to app.
+#
+# Only a pull request merged into main is imported. A merge into any other
+# branch, including the gated uplink/conflict, uplink/amend and
+# uplink/transfer-* bases, has not passed main's review and is handled by its
+# own workflow or not at all. `add --base-branch` refuses it again, in case
+# the filter below is edited.
+#
+# An upstream import rebuilds main so the patch sits under the internal
+# patches. That rebuild is not preflighted: the pull request that merged the
+# change was reviewed and checked. If it stops on a patch (the queue is
+# blocked on a conflict), the change is still recorded and that conflict PR
+# is opened or kept. For a main that turned out broken, run Uplink verify.
+#
+# The change is on main already, so it is recorded whatever it fails. An
+# upstream-bound change that fails its assessment or its export preflight
+# (the required PR checks were bypassed, or something moved after them) is
+# recorded internal-only, and a gated transfer to upstream is opened for it,
+# as Uplink transfer would. Merging that PR moves it to the upstream queue;
+# closing it leaves the patch internal-only.
+#
+# With repository variable UPLINK_AUTO_SUBMIT set to `true`, import dispatches
+# Uplink submit for the patch when no upstream dependency of it is unmerged.
+name: Uplink import
+
+on:
+  pull_request:
+    types: [closed]
+    branches:
+      - main
+
+concurrency:
+  group: uplink-mutate
+  queue: max
+
+permissions: {}
+
+jobs:
+  # preflight.sh builds and runs product code (public upstream's included),
+  # so it runs in this job: read-only token, no App token, no Environment,
+  # no credentials in the checkout. The job that holds the write tokens
+  # takes the result and never runs the script.
+  preflight:
+    name: Preflight (no credentials)
+    if: github.event.pull_request.merged
+    runs-on: ubuntu-latest
+    permissions:
+      contents: read
+    outputs:
+      report: ${{ steps.run.outputs.report }}
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          fetch-depth: 0
+          persist-credentials: false
+          ref: ${{ github.event.pull_request.merge_commit_sha }}
+
+      - uses: $/.github/actions/install-git-uplink
+        with:
+          repo: ${{ vars.UPLINK_SRC }}
+          version: ${{ vars.UPLINK_VERSION }}
+          signer: ${{ vars.UPLINK_SIGNER }}
+          token: ${{ secrets.GITHUB_TOKEN }}
+
+      - name: Fetch what preflight reads
+        env:
+          UPLINK_INTERNAL_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          FROM_SHA: ${{ github.event.pull_request.base.sha }}
+          HEAD_SHA: ${{ github.event.pull_request.head.sha }}
+        run: |
+          set -euo pipefail
+          git uplink init
+          fetch_origin() {
+            local auth
+            auth=$(printf 'x-access-token:%s' "$UPLINK_INTERNAL_TOKEN" | base64 -w0)
+            git \
+              -c "http.${GITHUB_SERVER_URL}/.extraheader=" \
+              -c "http.${GITHUB_SERVER_URL}/.extraheader=Authorization: Basic ${auth}" \
+              fetch --quiet origin "$@"
+          }
+          fetch_origin "$FROM_SHA" "$HEAD_SHA"
+
+      - name: Run company toolchain hook
+        uses: $/.github/actions/uplink-toolchain-hook
+        with:
+          token: ${{ secrets.GITHUB_TOKEN }}
+
+      # No token in this step: git uplink refuses to run preflight.sh in a
+      # CI job step that holds one.
+      - name: Run preflight.sh
+        id: run
+        env:
+          TITLE: ${{ github.event.pull_request.title }}
+          BODY: ${{ github.event.pull_request.body }}
+          INTERNAL_ONLY: ${{ contains(github.event.pull_request.labels.*.name, 'uplink:internal-only') }}
+          FROM_SHA: ${{ github.event.pull_request.base.sha }}
+          HEAD_SHA: ${{ github.event.pull_request.head.sha }}
+        run: |
+          {
+            printf '%s\n\n' "$TITLE"
+            printf '%s\n' "${BODY:-}"
+          } > "$RUNNER_TEMP/uplink-msg.txt"
+          extra=()
+          if [ "$INTERNAL_ONLY" = "true" ]; then extra+=(--internal-only); fi
+          report=$(git uplink preflight --json --title "$TITLE" \
+            --message-file "$RUNNER_TEMP/uplink-msg.txt" \
+            --from "$FROM_SHA" --head "$HEAD_SHA" "${extra[@]}") || true
+          if ! jq -e . >/dev/null 2>&1 <<<"$report"; then
+            echo "git uplink printed no preflight result"
+            exit 1
+          fi
+          echo "report=$(jq -c . <<<"$report")" >> "$GITHUB_OUTPUT"
+
+  import:
+    needs: preflight
+    if: github.event.pull_request.merged
+    runs-on: ubuntu-latest
+    permissions:
+      contents: write
+      pull-requests: write
+      actions: write
+    steps:
+      - uses: $/.github/actions/install-git-uplink
+        with:
+          repo: ${{ vars.UPLINK_SRC }}
+          version: ${{ vars.UPLINK_VERSION }}
+          signer: ${{ vars.UPLINK_SIGNER }}
+          token: ${{ secrets.GITHUB_TOKEN }}
+
+      - name: Mint internal GitHub App token
+        id: internal-app
+        if: ${{ vars.UPLINK_INTERNAL_AUTH != 'pat' }}
+        uses: actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1 # v3.2.0
+        with:
+          app-id: ${{ secrets.UPLINK_INTERNAL_APP_ID }}
+          private-key: ${{ secrets.UPLINK_INTERNAL_APP_PRIVATE_KEY }}
+          owner: ${{ github.repository_owner }}
+          repositories: ${{ github.event.repository.name }}
+          permission-contents: write
+          permission-workflows: write
+          permission-pull-requests: write
+
+      # The checkout keeps the internal token: a rebuild that stops on a
+      # patch pushes its conflict branches. This job runs no product code.
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          fetch-depth: 0
+          persist-credentials: true
+          ref: ${{ github.event.pull_request.merge_commit_sha }}
+          token: ${{ steps.internal-app.outputs.token || secrets.UPLINK_INTERNAL_TOKEN }}
+
+      - name: Import as a queued patch
+        id: add
+        env:
+          TITLE: ${{ github.event.pull_request.title }}
+          BODY: ${{ github.event.pull_request.body }}
+          INTERNAL_ONLY: ${{ contains(github.event.pull_request.labels.*.name, 'uplink:internal-only') }}
+          PR_NUMBER: ${{ github.event.pull_request.number }}
+          PR_URL: ${{ github.event.pull_request.html_url }}
+          BASE_REF: ${{ github.event.pull_request.base.ref }}
+          FROM_SHA: ${{ github.event.pull_request.base.sha }}
+          HEAD_SHA: ${{ github.event.pull_request.head.sha }}
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          GH_REPO: ${{ github.repository }}
+          UPLINK_INTERNAL_TOKEN: ${{ steps.internal-app.outputs.token || secrets.UPLINK_INTERNAL_TOKEN }}
+          PREFLIGHT_REPORT: ${{ needs.preflight.outputs.report }}
+        run: |
+          git uplink init
+          printf '%s' "$PREFLIGHT_REPORT" > "$RUNNER_TEMP/uplink-preflight.json"
+          main_before=$(git rev-parse --verify --quiet refs/heads/main || true)
+          extra=()
+          if [ "$INTERNAL_ONLY" = "true" ]; then extra+=(--internal-only); fi
+          {
+            printf '%s\n\n' "$TITLE"
+            printf '%s\n' "${BODY:-}"
+          } > /tmp/uplink-msg.txt
+          set +e
+          git uplink add --title "$TITLE" --message-file /tmp/uplink-msg.txt \
+            --from "$FROM_SHA" --head "$HEAD_SHA" --base-branch "$BASE_REF" \
+            --pr "$PR_NUMBER" --pr-url "$PR_URL" \
+            --preflight-result "$RUNNER_TEMP/uplink-preflight.json" --gate --json "${extra[@]}" > /tmp/uplink-add.out
+          code=$?
+          set -e
+          # The pull request is closed, so the failure is reported on the
+          # run. What is left to fail here is not about the change itself
+          # (a preflight result for another tree, a dependency that is not
+          # in the queue): run the job again once that is sorted out.
+          if [ "$code" -ne 0 ]; then
+            {
+              echo "Import of #${PR_NUMBER} failed. The change is on \`main\` and not in the queue, so the next rebuild leaves it out."
+              echo
+              cat /tmp/uplink-add.out
+            } >> "$GITHUB_STEP_SUMMARY"
+            exit "$code"
+          fi
+
+          # The change fails what an upstream-bound patch has to pass. It is
+          # recorded internal-only, where it sits on main, and a transfer to
+          # upstream is open for it: publish that as the gated transfer PR.
+          # (A transfer that went through at once left it upstream-bound:
+          # that is an ordinary import, handled below.)
+          if jq -e '.fallback != null and .fallback.transfer.transferred != true' /tmp/uplink-add.out >/dev/null; then
+            add_json=$(cat /tmp/uplink-add.out)
+            patch_id=$(jq -r '.id' <<<"$add_json")
+            git uplink push
+            {
+              echo "#${PR_NUMBER} was recorded internal-only as \`${patch_id}\`: it fails what an upstream-bound patch has to pass."
+              echo
+              jq -r '.fallback.reason' <<<"$add_json"
+            } >> "$GITHUB_STEP_SUMMARY"
+            if [ "$(jq -r '.fallback.transfer.gated // false' <<<"$add_json")" != "true" ]; then
+              why=$(jq -r '.fallback.transferError // "the transfer was not gated"' <<<"$add_json")
+              echo "::warning title=Uplink import::${patch_id} stays internal-only; start Uplink transfer for it by hand (${why//$'\n'/ })"
+              exit 0
+            fi
+            base=$(jq -r '.fallback.transfer.base // empty' <<<"$add_json")
+            work=$(jq -r '.fallback.transfer.work // empty' <<<"$add_json")
+            if [ -z "$base" ] || [ -z "$work" ]; then
+              echo "transfer is gated but no base/work branches were recorded"
+              exit 1
+            fi
+            git push origin "refs/heads/${base}:refs/heads/${base}" --force
+            git push origin "refs/heads/${work}:refs/heads/${work}" --force
+            title=$(jq -r '.fallback.transfer.gh.prCreate.title' <<<"$add_json")
+            body_file=$(jq -r '.fallback.transfer.gh.prCreate.bodyFile' <<<"$add_json")
+            label=$(jq -r '.fallback.transfer.gh.prCreate.labels[0]' <<<"$add_json")
+            gh label create "$label" --description "Uplink gated transfer" --color 1D76DB || true
+            # The internal bot opens the PR: GITHUB_TOKEN may not create PRs, and a
+            # bot-opened PR triggers the Uplink gate check. The Actions token labels it.
+            url=$(GH_TOKEN="$UPLINK_INTERNAL_TOKEN" gh pr create --title "$title" --base "$base" --head "$work" --body-file "$body_file")
+            gh pr edit "$url" --add-label "$label"
+            echo "Transfer PR: $url" >> "$GITHUB_STEP_SUMMARY"
+            exit 0
+          fi
+          echo "ready_to_submit=$(jq -c '.readyToSubmit // []' /tmp/uplink-add.out)" >> "$GITHUB_OUTPUT"
+
+          # The change is recorded, and the rebuild that puts it under the
+          # internal patches stopped on a patch: the queue is blocked on a
+          # conflict, old or new. Main keeps the merge as the PR left it.
+          if jq -e '.conflict != null' /tmp/uplink-add.out >/dev/null; then
+            add_json=$(cat /tmp/uplink-add.out)
+            git uplink push
+            conflict_id=$(jq -r '.conflict.id // empty' <<<"$add_json")
+            conflict_branch=$(jq -r '.conflict.branch // empty' <<<"$add_json")
+            work_branch=$(jq -r '.conflict.workBranch // empty' <<<"$add_json")
+            if [ -z "$conflict_id" ] || [ "$conflict_id" = "null" ]; then
+              echo "import recorded a conflict but no conflict patch id was present"
+              exit 1
+            fi
+            if git show-ref --verify --quiet "refs/heads/${conflict_branch}"; then
+              git push origin "refs/heads/${conflict_branch}:refs/heads/${conflict_branch}" --force
+            fi
+            if [ -n "$work_branch" ] && git show-ref --verify --quiet "refs/heads/${work_branch}"; then
+              git push origin "refs/heads/${work_branch}:refs/heads/${work_branch}" --force
+            fi
+
+            title=$(jq -r '.gh.prCreate.title' <<<"$add_json")
+            body_file=$(jq -r '.gh.prCreate.bodyFile' <<<"$add_json")
+            head=$(jq -r '.gh.prCreate.head' <<<"$add_json")
+            base=$(jq -r '.gh.prCreate.base' <<<"$add_json")
+            existing=$(gh pr list --head "$head" --base "$base" --state open --json url --jq '.[0].url')
+            if [ -z "$existing" ]; then
+              gh label create uplink:conflict --description "Uplink sync conflict; resolve via the gated work PR" --color B60205 || true
+              # The internal bot opens the PR: GITHUB_TOKEN may not create PRs, and a
+              # bot-opened PR triggers the Uplink gate check. The Actions token labels it.
+              url=$(GH_TOKEN="$UPLINK_INTERNAL_TOKEN" gh pr create --title "$title" --base "$base" --head "$head" --body-file "$body_file")
+              gh pr edit "$url" --add-label uplink:conflict
+            else
+              url="$existing"
+            fi
+            git uplink gated "$conflict_id" --pr-url "$url"
+            exit 0
+          fi
+          # State first: a rejected state push leaves origin main alone.
+          # Main is pushed when the import rebuilt it, to put an upstream
+          # patch under the internal ones. It is not rebuilt again here: a
+          # rebuild by itself is preflighted, and this job runs no script.
+          git uplink push
+          main_after=$(git rev-parse --verify --quiet refs/heads/main || true)
+          if [ -n "$main_after" ] && [ "$main_after" != "$main_before" ]; then
+            git push origin main --force
+          fi
+
+      - name: Dispatch Uplink submit for patches that became ready
+        if: ${{ vars.UPLINK_AUTO_SUBMIT == 'true' && steps.add.outputs.ready_to_submit != '' && steps.add.outputs.ready_to_submit != '[]' }}
+        uses: $/.github/actions/uplink-dispatch-submit
+        with:
+          patch-ids: ${{ steps.add.outputs.ready_to_submit }}
+          token: ${{ secrets.GITHUB_TOKEN }}
+
+      # A rebuild writes every commit of main again. Tell the open pull
+      # requests it left behind how to rebase; a failure here is not a
+      # failure of the job.
+      - name: Tell open pull requests about a rebuilt main
+        continue-on-error: true
+        uses: $/.github/actions/uplink-rebase-comment
+        with:
+          token: ${{ secrets.GITHUB_TOKEN }}
+          auto-rebase: ${{ vars.UPLINK_AUTO_REBASE }}
