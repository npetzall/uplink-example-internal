index 0000000000000000000000000000000000000000..a691efc47f04adbe77a0439baeafd8b32ce25eb8
--- /dev/null
+++ b/.github/actions/install-git-uplink/action.yml
@@ -0,0 +1,82 @@
+name: Install git-uplink
+description: Download a git-uplink release binary and put it on PATH for this runner.
+inputs:
+  repo:
+    description: GitHub repository (owner/name) that publishes git-uplink releases. Empty means npetzall/git-uplink.
+    required: false
+    default: ""
+  version:
+    description: Release tag (vX.Y.Z), version (X.Y.Z), or latest. Empty means the release that wrote this pack.
+    required: false
+    default: ""
+  token:
+    description: Token for gh release download. Workflows pass secrets.GITHUB_TOKEN.
+    required: false
+    default: ""
+  signer:
+    description: Certificate identity that signed the release. Empty means the release workflow of npetzall/git-uplink on main.
+    required: false
+    default: ""
+runs:
+  using: composite
+  steps:
+    - uses: sigstore/cosign-installer@6f9f17788090df1f26f669e9d70d6ae9567deba6 # v4.1.2
+    - name: Install git-uplink
+      shell: bash
+      env:
+        REPO: ${{ inputs.repo }}
+        VERSION: ${{ inputs.version }}
+        TOKEN: ${{ inputs.token }}
+        SIGNER: ${{ inputs.signer }}
+      run: | # zizmor: ignore[github-env] constant PATH entry for release binary
+        set -euo pipefail
+        REPO="${REPO:-npetzall/git-uplink}"
+        # git uplink init writes its own version here.
+        VERSION="${VERSION:-0.1.0}"
+        SIGNER="${SIGNER:-https://github.com/npetzall/git-uplink/.github/workflows/release.yml@refs/heads/main}"
+        if [[ "$VERSION" != "latest" ]]; then
+          tag="$VERSION"
+          if [[ "$tag" != v* ]]; then
+            tag="v$tag"
+          fi
+        fi
+        download_release() {
+          if [[ "$VERSION" == "latest" ]]; then
+            gh release download --repo "$REPO" "$@"
+          else
+            gh release download "$tag" --repo "$REPO" "$@"
+          fi
+        }
+        case "${RUNNER_OS}-${RUNNER_ARCH}" in
+          Linux-X64) target="x86_64-unknown-linux-musl"; suffix="" ;;
+          Linux-ARM64) target="aarch64-unknown-linux-musl"; suffix="" ;;
+          macOS-ARM64) target="aarch64-apple-darwin"; suffix="" ;;
+          Windows-X64) target="x86_64-pc-windows-msvc"; suffix=".exe" ;;
+          *)
+            echo "unsupported runner: ${RUNNER_OS}-${RUNNER_ARCH}" >&2
+            exit 1
+            ;;
+        esac
+        if [[ -n "$TOKEN" ]]; then
+          export GH_TOKEN="$TOKEN"
+        fi
+        rm -rf _git-uplink-dl
+        mkdir -p _git-uplink-dl "$HOME/.local/bin"
+        asset="git-uplink-${target}${suffix}"
+        download_release --pattern "$asset" --pattern "$asset.sigstore.json" --pattern SHA256SUMS --dir _git-uplink-dl
+        (
+          cd _git-uplink-dl
+          if [[ ! -f "$asset" || ! -f "$asset.sigstore.json" ]]; then
+            echo "release asset $asset or its signature $asset.sigstore.json not found" >&2
+            exit 1
+          fi
+          sha256sum -c SHA256SUMS --ignore-missing
+          cosign verify-blob "$asset" \
+            --bundle "$asset.sigstore.json" \
+            --certificate-identity "$SIGNER" \
+            --certificate-oidc-issuer https://token.actions.githubusercontent.com
+        )
+        install -m 755 "_git-uplink-dl/$asset" "$HOME/.local/bin/git-uplink"
+        echo "$HOME/.local/bin" >> "$GITHUB_PATH"
+        rm -rf _git-uplink-dl
+        git-uplink -h >/dev/null
