diff --git a/.github/workflows/uplink-abandon.yml b/.github/workflows/uplink-abandon.yml
new file mode 100644
index 0000000000000000000000000000000000000000..1aa599fe750a9e491c6b6f263d9771d4ee009e31
--- /dev/null
+++ b/.github/workflows/uplink-abandon.yml
@@ -0,0 +1,162 @@
+# example-github forge pack (`git uplink init --forge example-github`).
+# Empty UPLINK_*_AUTH defaults to pat.
+#
+# Detached public cleanup after --to-internal of a submitted patch.
+# Transfer dispatches this workflow and does not wait. Contrib credentials
+# live on Environment `abandon-contrib` (same secrets as to-upstream,
+# different reviewers). Closing the public PR uses repository
+# UPLINK_UPSTREAM_* (pull requests write on the parent). Deleting the fork
+# branch uses UPLINK_CONTRIB_*. This job must not take uplink-mutate.
+#
+# Until reviewers approve abandon-contrib, company state is already
+# internal-only while the public PR and uplink/<id> fork branch remain.
+name: Uplink abandon contrib
+run-name: Uplink abandon contrib ${{ inputs.patch_id }}
+
+on:
+  workflow_dispatch:
+    inputs:
+      patch_id:
+        description: Patch id whose public contribution is being abandoned
+        required: true
+      pr_url:
+        description: Public contrib PR URL to close
+        required: false
+      contrib_branch:
+        description: Fork branch to delete (uplink/<id>)
+        required: false
+
+concurrency:
+  group: uplink-abandon-${{ inputs.patch_id }}
+  cancel-in-progress: true
+
+permissions: {}
+
+jobs:
+  abandon:
+    name: Close public PR and delete contrib branch
+    if: github.ref == 'refs/heads/main'
+    runs-on: ubuntu-latest
+    permissions:
+      contents: read
+      deployments: write
+    environment:
+      name: abandon-contrib
+    steps:
+      - name: Read upstream and contrib from the queue
+        id: queue
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: |
+          set -euo pipefail
+          content=$(gh api "repos/${GITHUB_REPOSITORY}/contents/.uplink/queue.json?ref=uplink%2Fstate" --jq .content)
+          queue=$(printf '%s' "$content" | tr -d '\n' | base64 -d)
+          parse_owner_repo() {
+            local url=$1 owner repo
+            if [[ "$url" =~ github.com[:/]([^/]+)/(.+)$ ]]; then
+              owner=${BASH_REMATCH[1]}
+              repo=${BASH_REMATCH[2]}
+              repo=${repo%.git}
+              repo=${repo%/}
+              printf '%s\n%s\n' "$owner" "$repo"
+              return 0
+            fi
+            echo "Could not parse GitHub owner/repo from queue URL" >&2
+            return 1
+          }
+          upstream_url=$(jq -r '.config.upstreamUrl // empty' <<<"$queue")
+          contrib_url=$(jq -r '.config.contribUrl // empty' <<<"$queue")
+          if [ -z "$upstream_url" ] || [ -z "$contrib_url" ]; then
+            echo "queue.json is missing upstreamUrl or contribUrl" >&2
+            exit 1
+          fi
+          mapfile -t upstream < <(parse_owner_repo "$upstream_url")
+          mapfile -t contrib < <(parse_owner_repo "$contrib_url")
+          same_owner=false
+          upstream_lc=$(printf '%s' "${upstream[0]}" | tr '[:upper:]' '[:lower:]')
+          contrib_lc=$(printf '%s' "${contrib[0]}" | tr '[:upper:]' '[:lower:]')
+          if [ "$upstream_lc" = "$contrib_lc" ]; then
+            same_owner=true
+          fi
+          {
+            echo "upstream_owner=${upstream[0]}"
+            echo "upstream_repo=${upstream[1]}"
+            echo "contrib_owner=${contrib[0]}"
+            echo "contrib_repo=${contrib[1]}"
+            echo "same_owner=${same_owner}"
+          } >> "$GITHUB_OUTPUT"
+
+      - name: Mint contrib GitHub App token
+        id: contrib-app
+        if: ${{ vars.UPLINK_CONTRIB_AUTH == 'app' && steps.queue.outputs.same_owner == 'true' }}
+        uses: actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1 # v3.2.0
+        with:
+          app-id: ${{ secrets.UPLINK_CONTRIB_APP_ID }}
+          private-key: ${{ secrets.UPLINK_CONTRIB_APP_PRIVATE_KEY }}
+          owner: ${{ steps.queue.outputs.contrib_owner }}
+          repositories: ${{ steps.queue.outputs.contrib_repo }}
+          permission-contents: write
+
+      - name: Mint upstream GitHub App token
+        id: upstream-app
+        if: ${{ vars.UPLINK_UPSTREAM_AUTH == 'app' && steps.queue.outputs.same_owner == 'true' }}
+        uses: actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1 # v3.2.0
+        with:
+          app-id: ${{ secrets.UPLINK_UPSTREAM_APP_ID }}
+          private-key: ${{ secrets.UPLINK_UPSTREAM_APP_PRIVATE_KEY }}
+          owner: ${{ steps.queue.outputs.upstream_owner }}
+          repositories: ${{ steps.queue.outputs.upstream_repo }},${{ steps.queue.outputs.contrib_repo }}
+          permission-contents: read
+          permission-pull-requests: write
+
+      - name: Close PR and delete fork branch
+        env:
+          GH_TOKEN: ${{ steps.upstream-app.outputs.token || secrets.UPLINK_UPSTREAM_TOKEN }}
+          UPLINK_CONTRIB_TOKEN: ${{ steps.contrib-app.outputs.token || secrets.UPLINK_CONTRIB_TOKEN }}
+          UPLINK_CONTRIB_OWNER: ${{ steps.queue.outputs.contrib_owner }}
+          UPLINK_CONTRIB_REPO: ${{ steps.queue.outputs.contrib_repo }}
+          PATCH_ID: ${{ inputs.patch_id }}
+          PR_URL: ${{ inputs.pr_url }}
+          CONTRIB_BRANCH: ${{ inputs.contrib_branch }}
+        run: |
+          set -euo pipefail
+          if [ -z "$PR_URL" ] && [ -z "$CONTRIB_BRANCH" ]; then
+            echo "No public PR URL or contrib branch to abandon for ${PATCH_ID}"
+            exit 1
+          fi
+
+          if [ -n "$PR_URL" ]; then
+            if ! gh pr close "$PR_URL" --comment "Abandoned public PR; ${PATCH_ID} moved to internal."; then
+              state=$(gh pr view "$PR_URL" --json state --jq '.state // empty' || true)
+              if [ "$state" != "CLOSED" ] && [ "$state" != "MERGED" ]; then
+                echo "failed to close ${PR_URL} (state=${state})"
+                exit 1
+              fi
+            fi
+          fi
+
+          branch="${CONTRIB_BRANCH}"
+          repo=""
+          if [ -n "$PR_URL" ]; then
+            repo=$(gh pr view "$PR_URL" --json headRepository --jq '.headRepository.nameWithOwner // empty' || true)
+            if [ -z "$branch" ]; then
+              branch=$(gh pr view "$PR_URL" --json headRefName --jq '.headRefName // empty' || true)
+            fi
+          fi
+          if [ -z "$repo" ] && [ -n "$UPLINK_CONTRIB_OWNER" ] && [ -n "$UPLINK_CONTRIB_REPO" ]; then
+            repo="${UPLINK_CONTRIB_OWNER}/${UPLINK_CONTRIB_REPO}"
+          fi
+          if [ -z "$branch" ]; then
+            echo "No contrib branch to delete for ${PATCH_ID}"
+            exit 0
+          fi
+          if [ -z "$repo" ]; then
+            echo "Cannot resolve contrib repository for ${branch}"
+            exit 1
+          fi
+          if ! GH_TOKEN="$UPLINK_CONTRIB_TOKEN" gh api --method DELETE "repos/${repo}/git/refs/heads/${branch}"; then
+            if GH_TOKEN="$UPLINK_CONTRIB_TOKEN" gh api "repos/${repo}/git/refs/heads/${branch}" >/dev/null 2>&1; then
+              echo "failed to delete ${repo} ${branch}"
+              exit 1
+            fi
+          fi
diff --git a/.github/workflows/uplink-gate.yml b/.github/workflows/uplink-gate.yml
new file mode 100644
index 0000000000000000000000000000000000000000..d2fb644fc238510f21c6498c29967fd3b21bbf66
--- /dev/null
+++ b/.github/workflows/uplink-gate.yml
@@ -0,0 +1,82 @@
+# example-github forge pack (`git uplink init --forge example-github`).
+# Required check on PRs into protected uplink bases. These PRs are not imports.
+# YAML is loaded from the default branch so *-work cannot replace this sidecar.
+# Origin fetch uses the Actions token as UPLINK_INTERNAL_TOKEN (contents: read).
+# The shell git fetch of the protected base uses that token for one command.
+name: Uplink gate
+
+on: # zizmor: ignore[dangerous-triggers] YAML from default branch; gated tree is data; contents: read; persist-credentials: false
+  pull_request_target:
+    types: [opened, synchronize, reopened]
+    branches:
+      - "uplink/conflict/**"
+      - "uplink/transfer-to-upstream/**"
+      - "uplink/transfer-to-internal/**"
+
+concurrency:
+  group: uplink-gate-${{ github.event.pull_request.number }}
+  cancel-in-progress: true
+
+permissions:
+  contents: read
+
+jobs:
+  validate:
+    if: ${{ !endsWith(github.event.pull_request.base.ref, '-work') }}
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+          ref: ${{ github.sha }}
+      - uses: $/.github/actions/install-git-uplink
+        with:
+          src: ${{ vars.UPLINK_SRC }}
+          rev: ${{ vars.UPLINK_REV }}
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          fetch-depth: 0
+          persist-credentials: false
+          ref: ${{ github.event.pull_request.head.sha }}
+
+      - name: Validate gated work
+        env:
+          UPLINK_INTERNAL_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          UPLINK_PREFLIGHT: ${{ vars.UPLINK_PREFLIGHT }}
+          BASE_REF: ${{ github.event.pull_request.base.ref }}
+          FROM_SHA: ${{ github.event.pull_request.base.sha }}
+          HEAD_SHA: ${{ github.event.pull_request.head.sha }}
+          TITLE: ${{ github.event.pull_request.title }}
+          BODY: ${{ github.event.pull_request.body }}
+        run: |
+          git uplink init
+          auth=$(printf 'x-access-token:%s' "$UPLINK_INTERNAL_TOKEN" | base64 -w0)
+          git \
+            -c "http.${GITHUB_SERVER_URL}/.extraheader=" \
+            -c "http.${GITHUB_SERVER_URL}/.extraheader=Authorization: Basic ${auth}" \
+            fetch origin "$BASE_REF" --depth=1
+          if git diff --name-only "$FROM_SHA" "$HEAD_SHA" | grep -E \
+            -q '^(\.github/workflows/uplink-.*\.yml|\.github/actions/install-git-uplink/)'; then
+            echo "Gated PRs must not change Uplink pack files (uplink-*.yml / install-git-uplink)."
+            echo "Edit product workflows as needed. Change sidecars on main via git uplink init --upgrade."
+            exit 1
+          fi
+          if git grep -I -l '^<<<<<<<' -- . ':!.uplink' >/dev/null 2>&1; then
+            echo "Conflict markers still present; remove them before merge."
+            exit 1
+          fi
+          if [[ "$BASE_REF" == uplink/transfer-to-upstream/* ]]; then
+            {
+              printf '%s\n\n' "$TITLE"
+              printf '%s\n' "${BODY:-}"
+            } > /tmp/uplink-msg.txt
+            git uplink preflight \
+              --title "$TITLE" \
+              --message-file /tmp/uplink-msg.txt \
+              --from "$FROM_SHA" \
+              --head "$HEAD_SHA"
+          elif [[ "$BASE_REF" == uplink/transfer-to-internal/* ]]; then
+            if [ -n "$UPLINK_PREFLIGHT" ]; then
+              sh -c "$UPLINK_PREFLIGHT"
+            fi
+          fi
diff --git a/.github/workflows/uplink-import.yml b/.github/workflows/uplink-import.yml
new file mode 100644
index 0000000000000000000000000000000000000000..3fd841a9319bb0d89dd0a276066ff64bca6af2dd
--- /dev/null
+++ b/.github/workflows/uplink-import.yml
@@ -0,0 +1,87 @@
+# example-github forge pack (`git uplink init --forge example-github`).
+# Installs git-uplink on the runner.
+# Empty UPLINK_*_AUTH defaults to pat.
+name: Uplink import
+
+on:
+  pull_request:
+    types: [closed]
+
+concurrency:
+  group: uplink-mutate
+  queue: max
+
+permissions:
+  contents: write
+  pull-requests: write
+
+jobs:
+  import:
+    if: github.event.pull_request.merged
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          fetch-depth: 0
+          persist-credentials: false
+          ref: ${{ github.event.pull_request.merge_commit_sha }}
+      - uses: $/.github/actions/install-git-uplink
+        with:
+          src: ${{ vars.UPLINK_SRC }}
+          rev: ${{ vars.UPLINK_REV }}
+
+      - name: Mint internal GitHub App token
+        id: internal-app
+        if: ${{ vars.UPLINK_INTERNAL_AUTH == 'app' }}
+        uses: actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1 # v3.2.0
+        with:
+          app-id: ${{ secrets.UPLINK_INTERNAL_APP_ID }}
+          private-key: ${{ secrets.UPLINK_INTERNAL_APP_PRIVATE_KEY }}
+          owner: ${{ github.repository_owner }}
+          repositories: ${{ github.event.repository.name }}
+          permission-contents: write
+          permission-workflows: write
+
+      - name: Import as a queued patch
+        env:
+          TITLE: ${{ github.event.pull_request.title }}
+          BODY: ${{ github.event.pull_request.body }}
+          INTERNAL_ONLY: ${{ contains(github.event.pull_request.labels.*.name, 'uplink:internal-only') }}
+          PR_NUMBER: ${{ github.event.pull_request.number }}
+          PR_URL: ${{ github.event.pull_request.html_url }}
+          FROM_SHA: ${{ github.event.pull_request.base.sha }}
+          HEAD_SHA: ${{ github.event.pull_request.head.sha }}
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          GH_REPO: ${{ github.repository }}
+          UPLINK_PREFLIGHT: ${{ vars.UPLINK_PREFLIGHT }}
+          UPLINK_INTERNAL_TOKEN: ${{ steps.internal-app.outputs.token || secrets.UPLINK_INTERNAL_TOKEN }}
+        run: |
+          git uplink init
+          extra=""
+          if [ "$INTERNAL_ONLY" = "true" ]; then extra="--internal-only"; fi
+          {
+            printf '%s\n\n' "$TITLE"
+            printf '%s\n' "${BODY:-}"
+          } > /tmp/uplink-msg.txt
+          set +e
+          git uplink add --title "$TITLE" --message-file /tmp/uplink-msg.txt \
+            --from "$FROM_SHA" --head "$HEAD_SHA" \
+            --pr "$PR_NUMBER" --pr-url "$PR_URL" $extra > /tmp/uplink-add.out
+          code=$?
+          set -e
+          if [ "$code" -ne 0 ]; then
+            if [ -s /tmp/uplink-add.out ]; then
+              gh pr comment "$PR_NUMBER" --body-file /tmp/uplink-add.out
+            fi
+            exit "$code"
+          fi
+          rebuild=false
+          if [ "$INTERNAL_ONLY" != "true" ]; then
+            active=$(jq '[.internal[]? | select(.status != "merged" and .status != "dropped")] | length' .uplink/queue.json)
+            if [ "$active" != "0" ]; then rebuild=true; fi
+          fi
+          if [ "$rebuild" = "true" ]; then
+            git uplink rebuild --push
+          else
+            git uplink push
+          fi
diff --git a/.github/workflows/uplink-pr.yml b/.github/workflows/uplink-pr.yml
new file mode 100644
index 0000000000000000000000000000000000000000..2c3616e64ba5c5cf7dc784e10749264768fb9977
--- /dev/null
+++ b/.github/workflows/uplink-pr.yml
@@ -0,0 +1,119 @@
+# example-github forge pack (`git uplink init --forge example-github`).
+# Installs git-uplink on the runner.
+#
+# Parallel required checks on every internal PR to company main except
+# uplink:internal-only. See templates/ghec/.github/workflows/uplink-pr.yml.
+# Origin fetch uses the Actions token as UPLINK_INTERNAL_TOKEN (contents: read).
+#
+# Company extras for the IP packet are not collected here (no patch id
+# yet). Add `.github/workflows/uplink-assessment-hook.yml` and see
+# templates/README.md "Assessment hook".
+name: Uplink PR checks
+
+on:
+  pull_request:
+    types: [opened, synchronize, reopened, edited]
+    branches:
+      - main
+
+concurrency:
+  group: uplink-pr-${{ github.event.pull_request.number }}
+  cancel-in-progress: true
+
+permissions:
+  contents: read
+
+jobs:
+  assess:
+    name: Uplink upstream assess
+    if: ${{ !contains(join(github.event.pull_request.labels.*.name, ','), 'uplink:internal-only') }}
+    runs-on: ubuntu-latest
+    permissions:
+      contents: read
+      pull-requests: write
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          fetch-depth: 0
+          persist-credentials: false
+          ref: ${{ github.event.pull_request.base.ref }}
+      - uses: $/.github/actions/install-git-uplink
+        with:
+          src: ${{ vars.UPLINK_SRC }}
+          rev: ${{ vars.UPLINK_REV }}
+      - name: Assess contribution
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          GH_REPO: ${{ github.repository }}
+          UPLINK_INTERNAL_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          UPLINK_REDACT_KEYWORDS: ${{ vars.UPLINK_REDACT_KEYWORDS }}
+          UPLINK_INTERNAL_DOMAINS: ${{ vars.UPLINK_INTERNAL_DOMAINS }}
+          UPLINK_EXPORT_AUTHOR: ${{ vars.UPLINK_EXPORT_AUTHOR }}
+          TITLE: ${{ github.event.pull_request.title }}
+          BODY: ${{ github.event.pull_request.body }}
+          FROM_SHA: ${{ github.event.pull_request.base.sha }}
+          HEAD_SHA: ${{ github.event.pull_request.head.sha }}
+          PR_NUMBER: ${{ github.event.pull_request.number }}
+        run: |
+          git uplink init
+          {
+            printf '%s\n\n' "$TITLE"
+            printf '%s\n' "${BODY:-}"
+          } > /tmp/uplink-msg.txt
+          set +e
+          git uplink assess \
+            --title "$TITLE" \
+            --message-file /tmp/uplink-msg.txt \
+            --from "$FROM_SHA" \
+            --head "$HEAD_SHA" > /tmp/uplink-assess.md
+          code=$?
+          set -e
+          gh pr comment "$PR_NUMBER" --body-file /tmp/uplink-assess.md
+          exit "$code"
+
+  preflight:
+    name: Uplink upstream preflight
+    if: ${{ !contains(join(github.event.pull_request.labels.*.name, ','), 'uplink:internal-only') }}
+    runs-on: ubuntu-latest
+    permissions:
+      contents: read
+      pull-requests: write
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          fetch-depth: 0
+          persist-credentials: false
+          ref: ${{ github.event.pull_request.base.ref }}
+      - uses: $/.github/actions/install-git-uplink
+        with:
+          src: ${{ vars.UPLINK_SRC }}
+          rev: ${{ vars.UPLINK_REV }}
+      - name: Export preflight
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          GH_REPO: ${{ github.repository }}
+          UPLINK_INTERNAL_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          UPLINK_PREFLIGHT: ${{ vars.UPLINK_PREFLIGHT }}
+          TITLE: ${{ github.event.pull_request.title }}
+          BODY: ${{ github.event.pull_request.body }}
+          FROM_SHA: ${{ github.event.pull_request.base.sha }}
+          HEAD_SHA: ${{ github.event.pull_request.head.sha }}
+          PR_NUMBER: ${{ github.event.pull_request.number }}
+        run: |
+          git uplink init
+          {
+            printf '%s\n\n' "$TITLE"
+            printf '%s\n' "${BODY:-}"
+          } > /tmp/uplink-msg.txt
+          set +e
+          git uplink preflight \
+            --title "$TITLE" \
+            --message-file /tmp/uplink-msg.txt \
+            --from "$FROM_SHA" \
+            --head "$HEAD_SHA" > /tmp/uplink-preflight.md
+          code=$?
+          set -e
+          if [ "$code" -ne 0 ]; then
+            gh pr comment "$PR_NUMBER" --body-file /tmp/uplink-preflight.md
+            exit "$code"
+          fi
