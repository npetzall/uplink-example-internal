index 0000000000000000000000000000000000000000..17426835a1bfbe154e885ac37d9146f189dbb71c
--- /dev/null
+++ b/.github/workflows/uplink-submit.yml
@@ -0,0 +1,260 @@
+# example-github forge pack (`git uplink init --forge example-github`).
+# Installs git-uplink on the runner.
+# CONTRIBUTION / IP gate. Packet, optional company assessment hook artifact, then
+# to-upstream environment. Empty UPLINK_*_AUTH defaults to pat.
+# Origin reads and uplink/state fast-forwards use the Actions token
+# (UPLINK_INTERNAL_TOKEN). Contrib force-push mints UPLINK_CONTRIB_*.
+# The public pull request is POST /repos/{parent}/pulls with UPLINK_UPSTREAM_*
+# (contents read on the parent and the fork, pull requests write, no contents
+# write on the fork) and maintainer_can_modify false. head is the branch
+# and head_repo is <contrib_owner>/<contrib_repo>.
+# Owner and repo come from queue.json. App mint runs only when both are the same owner.
+name: Uplink submit
+run-name: Uplink submit ${{ inputs.patch_id }}
+
+on:
+  workflow_dispatch:
+    inputs:
+      patch_id:
+        description: Patch id to export (upl_…)
+        required: true
+
+permissions: {}
+
+jobs:
+  packet:
+    name: Write contribution packet
+    if: github.ref == 'refs/heads/main'
+    runs-on: ubuntu-latest
+    permissions:
+      contents: write
+    concurrency:
+      group: uplink-mutate
+      queue: max
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          fetch-depth: 0
+          persist-credentials: true
+      - uses: $/.github/actions/install-git-uplink
+        with:
+          src: ${{ vars.UPLINK_SRC }}
+          rev: ${{ vars.UPLINK_REV }}
+
+      - name: Write approver packet
+        env:
+          UPLINK_INTERNAL_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          PATCH_ID: ${{ inputs.patch_id }}
+        run: |
+          git uplink init
+          git uplink report "$PATCH_ID"
+          git push origin uplink/state
+
+  finalize:
+    name: Apply company packet extras
+    needs: packet
+    if: github.ref == 'refs/heads/main'
+    runs-on: ubuntu-latest
+    timeout-minutes: 45
+    permissions:
+      contents: write
+      actions: write
+    concurrency:
+      group: uplink-mutate
+      queue: max
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          fetch-depth: 0
+          persist-credentials: true
+      - uses: $/.github/actions/install-git-uplink
+        with:
+          src: ${{ vars.UPLINK_SRC }}
+          rev: ${{ vars.UPLINK_REV }}
+
+      - name: Dispatch company packet hooks
+        id: hooks
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          PATCH_ID: ${{ inputs.patch_id }}
+          CALLER_RUN_ID: ${{ github.run_id }}
+        run: |
+          set -euo pipefail
+          if ! git cat-file -e "HEAD:.github/workflows/uplink-assessment-hook.yml" 2>/dev/null; then
+            echo "No .github/workflows/uplink-assessment-hook.yml on this ref; skipping extras."
+            echo "run_id=" >> "$GITHUB_OUTPUT"
+            exit 0
+          fi
+          gh workflow run uplink-assessment-hook.yml --ref "${GITHUB_REF_NAME}" \
+            -f "patch_id=${PATCH_ID}" \
+            -f "caller_run_id=${CALLER_RUN_ID}"
+          run_id=""
+          for _ in $(seq 1 30); do
+            run_id=$(gh run list --workflow=uplink-assessment-hook.yml --event=workflow_dispatch --limit 20 \
+              --json databaseId,displayTitle \
+              --jq "[.[] | select((.displayTitle // \"\") | contains(\"${CALLER_RUN_ID}\") and contains(\"${PATCH_ID}\")) | .databaseId][0] // empty")
+            if [ -n "$run_id" ]; then
+              break
+            fi
+            sleep 2
+          done
+          if [ -z "$run_id" ]; then
+            echo "Timed out waiting for Uplink assessment hook run (patch ${PATCH_ID}, caller ${CALLER_RUN_ID})"
+            exit 1
+          fi
+          gh run watch "$run_id" --exit-status
+          echo "run_id=${run_id}" >> "$GITHUB_OUTPUT"
+
+      # v8 has no if-no-artifact-found; ignore a hook that uploaded nothing.
+      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
+        if: steps.hooks.outputs.run_id != ''
+        continue-on-error: true
+        with:
+          name: uplink-packet-extra
+          path: ${{ runner.temp }}/uplink-packet-extra
+          run-id: ${{ steps.hooks.outputs.run_id }}
+          github-token: ${{ secrets.GITHUB_TOKEN }}
+
+      - name: Reassemble packet with extras
+        env:
+          UPLINK_INTERNAL_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          PATCH_ID: ${{ inputs.patch_id }}
+          EXTRA_DIR: ${{ runner.temp }}/uplink-packet-extra
+        run: |
+          set -euo pipefail
+          git uplink init
+          if [ -d "$EXTRA_DIR" ] && find "$EXTRA_DIR" -name '*.md' -type f | grep -q .; then
+            git uplink report "$PATCH_ID" --extra-dir "$EXTRA_DIR"
+            git push origin uplink/state
+          else
+            packet=$(git show "uplink/state:.uplink/reports/${PATCH_ID}/assessment.md")
+            printf '%s\n' "$packet" >> "$GITHUB_STEP_SUMMARY"
+          fi
+
+  # Do not put uplink-mutate on this job. A required-reviewer environment
+  # holds its concurrency group the whole time the job is Waiting, which
+  # would freeze import/resolve/transfer and block resolve's cancel+redispatch.
+  submit:
+    name: Approve to-upstream environment and submit
+    needs: finalize
+    if: github.ref == 'refs/heads/main'
+    runs-on: ubuntu-latest
+    permissions:
+      contents: write
+      deployments: write
+    environment:
+      name: to-upstream
+      url: ${{ github.server_url }}/${{ github.repository }}/blob/uplink/state/.uplink/reports/${{ inputs.patch_id }}/assessment.md
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          fetch-depth: 0
+          persist-credentials: false
+          ref: main
+      - uses: $/.github/actions/install-git-uplink
+        with:
+          src: ${{ vars.UPLINK_SRC }}
+          rev: ${{ vars.UPLINK_REV }}
+      - name: Read upstream and contrib from the queue
+        id: queue
+        env:
+          UPLINK_INTERNAL_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: |
+          set -euo pipefail
+          config=$(git uplink init --json)
+          jq -r '
+            def owner_repo:
+              sub("\\.git$";"") | sub("/$";"")
+              | capture("github\\.com[:/](?<owner>[^/]+)/(?<repo>.+)$")
+              // error("Could not parse GitHub owner/repo from queue URL");
+            (.upstreamUrl // "") as $u | (.contribUrl // "") as $c
+            | if ($u == "" or $c == "") then error("queue.json is missing upstreamUrl or contribUrl") else . end
+            | ($u | owner_repo) as $up | ($c | owner_repo) as $co
+            | "upstream_owner=\($up.owner)",
+              "upstream_repo=\($up.repo)",
+              "contrib_owner=\($co.owner)",
+              "contrib_repo=\($co.repo)",
+              "same_owner=\(if ($up.owner | ascii_downcase) == ($co.owner | ascii_downcase) then "true" else "false" end)"
+          ' <<<"$config" >> "$GITHUB_OUTPUT"
+
+      - name: Mint contrib GitHub App token
+        id: contrib-app
+        if: ${{ vars.UPLINK_CONTRIB_AUTH == 'app' && steps.queue.outputs.same_owner == 'true' }}
+        uses: actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1 # v3.2.0
+        with:
+          app-id: ${{ secrets.UPLINK_CONTRIB_APP_ID }}
+          private-key: ${{ secrets.UPLINK_CONTRIB_APP_PRIVATE_KEY }}
+          owner: ${{ steps.queue.outputs.contrib_owner }}
+          repositories: ${{ steps.queue.outputs.contrib_repo }}
+          permission-contents: write
+
+      - name: Mint upstream GitHub App token
+        id: upstream-app
+        if: ${{ vars.UPLINK_UPSTREAM_AUTH == 'app' && steps.queue.outputs.same_owner == 'true' }}
+        uses: actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1 # v3.2.0
+        with:
+          app-id: ${{ secrets.UPLINK_UPSTREAM_APP_ID }}
+          private-key: ${{ secrets.UPLINK_UPSTREAM_APP_PRIVATE_KEY }}
+          owner: ${{ steps.queue.outputs.upstream_owner }}
+          repositories: ${{ steps.queue.outputs.upstream_repo }},${{ steps.queue.outputs.contrib_repo }}
+          permission-contents: read
+          permission-pull-requests: write
+
+      - name: Record approval, export, and record the public PR
+        env:
+          GH_TOKEN: ${{ steps.upstream-app.outputs.token || secrets.UPLINK_UPSTREAM_TOKEN }}
+          UPLINK_INTERNAL_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          UPLINK_CONTRIB_TOKEN: ${{ steps.contrib-app.outputs.token || secrets.UPLINK_CONTRIB_TOKEN }}
+          UPLINK_PREFLIGHT: ${{ vars.UPLINK_PREFLIGHT }}
+          UPLINK_TO_UPSTREAM_ENVIRONMENT: to-upstream
+          PATCH_ID: ${{ inputs.patch_id }}
+          HEAD_REPO: ${{ steps.queue.outputs.contrib_owner }}/${{ steps.queue.outputs.contrib_repo }}
+        run: |
+          git uplink approve "$PATCH_ID"
+          submit_json=$(git uplink submit "$PATCH_ID")
+
+          repo=$(jq -r '.gh.prCreate.repo // empty' <<<"$submit_json")
+          head=$(jq -r '.gh.prCreate.head // empty' <<<"$submit_json")
+          if [ -n "$repo" ] && [ -n "$head" ]; then
+            parent_owner=${repo%%/*}
+            head_owner=${head%%:*}
+            parent_lc=$(printf '%s' "$parent_owner" | tr '[:upper:]' '[:lower:]')
+            head_lc=$(printf '%s' "$head_owner" | tr '[:upper:]' '[:lower:]')
+            if [ "$parent_lc" = "$head_lc" ]; then
+              account_type=$(gh api "users/${parent_owner}" --jq '.type // empty' || true)
+              if [ "$account_type" = "User" ]; then
+                echo "Upstream and the contribution fork cannot both be under a user account. Fork into the same organization, or use a different owner with a machine user classic PAT."
+                exit 1
+              fi
+            else
+              case "$GH_TOKEN" in
+                ghp_*) ;;
+                *)
+                  echo "Upstream and the contribution fork are different owners. Fine-grained PATs and GitHub App tokens cannot open this pull request. Use a machine user with a classic PAT."
+                  exit 1
+                  ;;
+              esac
+            fi
+          fi
+          url=$(jq -r '.existingPr.url // empty' <<<"$submit_json")
+          if [ -z "$url" ] && [ -n "$repo" ] && [ -n "$head" ]; then
+            url=$(gh api --method GET "/repos/${repo}/pulls" -f state=open -f head="$head" --jq '.[0].html_url // empty')
+          fi
+          if [ -z "$url" ]; then
+            title=$(jq -r .gh.prCreate.title <<<"$submit_json")
+            body_file=$(jq -r .gh.prCreate.bodyFile <<<"$submit_json")
+            base=$(jq -r .gh.prCreate.base <<<"$submit_json")
+            branch=$(jq -r '.branch // empty' <<<"$submit_json")
+            url=$(gh api --method POST \
+              -H "Accept: application/vnd.github+json" \
+              -H "X-GitHub-Api-Version: 2022-11-28" \
+              "/repos/${repo}/pulls" \
+              -f title="$title" \
+              -F "body=@${body_file}" \
+              -f head="$branch" \
+              -f head_repo="$HEAD_REPO" \
+              -f base="$base" \
+              -F maintainer_can_modify=false \
+              --jq .html_url)
+          fi
+          git uplink submitted "$PATCH_ID" --pr-url "$url"
