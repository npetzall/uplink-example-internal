@@ -0,0 +1,417 @@
+# CONTRIBUTION / IP gate. Dispatch from company main with a patch id.
+# This is where the patch is assessed. The pull request checks are advice,
+# and nothing from them is stored.
+# Assess job (no queue lock) runs `git uplink assess` on the patch file and
+# uploads the assessment package as artifact uplink-assessment. It then runs
+# the optional company `.github/workflows/uplink-assessment-hook.yml` from
+# branch uplink/hooks, which reads that package, unless the assessment has
+# findings (an unmerged upstream dependency is one) or an earlier run of this
+# workflow stored the hook's result and the patch is unchanged since. A failed
+# hook is noted at the top of assessment.md; it does not fail submit.
+# Packet job then stores the assessment of the package, writes assessment.md
+# once on uplink/state (holding uplink-mutate only for that), and stores a
+# successful hook result. It refuses a package that is not for the patch as it
+# is now, and fails after writing the packet when the assessment has findings.
+# Submit job then waits on Environment `to-upstream`.
+# The packet job hands the packet's review token and uplink/state commit to
+# the submit job. The Environment links that commit's assessment.md, and
+# `approve --reviewed` stops when the patch is no longer what was reviewed
+# (amended, resolved or replayed while the run waited).
+# Resolve of an already-submitted patch dispatches this workflow so IP can
+# approve the delta.
+# With repository variable UPLINK_AUTO_SUBMIT set to `true`, import, sync,
+# transfer and resolve dispatch it for a queued patch as soon as none of its upstream
+# dependencies is unmerged. Such a run waits on `to-upstream` like any other.
+#
+# Empty UPLINK_*_AUTH defaults to app.
+# Origin reads and uplink/state fast-forwards use the Actions token
+# (UPLINK_INTERNAL_TOKEN). The contrib commit is created through the Git
+# Database API with UPLINK_CONTRIB_* (contents write on the fork); GitHub signs
+# it, and it is Verified only for a GitHub App token.
+# The public pull request is POST /repos/{parent}/pulls with UPLINK_UPSTREAM_*
+# (contents read on the parent and the fork, pull requests write, no contents
+# write on the fork) and maintainer_can_modify false. head is the branch
+# and head_repo is <contrib_owner>/<contrib_repo>.
+# Owner and repo come from queue.json. App mint runs only when both are the same owner.
+name: Uplink submit
+run-name: Uplink submit ${{ inputs.patch_id }}
+
+on:
+  workflow_dispatch:
+    inputs:
+      patch_id:
+        description: Patch id to export (upl_…)
+        required: true
+
+permissions: {}
+
+jobs:
+  # No uplink-mutate here: the hook can run for many minutes and must not hold
+  # the queue lock. This job only reads uplink/state.
+  assess:
+    name: Assess the patch
+    if: github.ref == 'refs/heads/main'
+    runs-on: ubuntu-latest
+    timeout-minutes: 45
+    permissions:
+      contents: read
+      actions: write
+    outputs:
+      fresh: ${{ steps.assess.outputs.fresh }}
+      hook_status: ${{ steps.hook.outputs.status }}
+      hook_run_url: ${{ steps.hook.outputs.run_url }}
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          fetch-depth: 0
+          persist-credentials: false
+          ref: main
+
+      - uses: $/.github/actions/install-git-uplink
+        with:
+          repo: ${{ vars.UPLINK_SRC }}
+          version: ${{ vars.UPLINK_VERSION }}
+          signer: ${{ vars.UPLINK_SIGNER }}
+          token: ${{ secrets.GITHUB_TOKEN }}
+
+      # The assessment package: assessment.json (result, public message,
+      # uplink.toml settings, queue entry), assessment.md and change.patch
+      # (the patch file). The hook reads it, and the packet job stores it.
+      # Assess also checks that upstream-bound Uplink-Depends-On patches are
+      # merged upstream, and whether a hook result stored by an earlier run
+      # is still for this patch content.
+      - name: Assess the patch
+        id: assess
+        env:
+          UPLINK_INTERNAL_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          PATCH_ID: ${{ inputs.patch_id }}
+        run: |
+          set -euo pipefail
+          git uplink init
+          out="$RUNNER_TEMP/uplink-assessment"
+          # Findings do not stop here: the packet job writes the packet that
+          # shows them, then stops before the Environment.
+          git uplink assess --patch "$PATCH_ID" --package "$out" || true
+          if [ ! -s "$out/assessment.json" ]; then
+            echo "git uplink assess wrote no assessment package"
+            exit 1
+          fi
+          ok=$(jq -r '.ok == true' "$out/assessment.json")
+          fresh=$(jq -r '.storedExtras.fresh == true' "$out/assessment.json")
+          echo "ok=${ok}" >> "$GITHUB_OUTPUT"
+          echo "fresh=${fresh}" >> "$GITHUB_OUTPUT"
+          if [ "$ok" != "true" ]; then
+            {
+              echo "The assessment of ${PATCH_ID} has findings; the hook is not run and nobody is asked to approve."
+              jq -r '.checks[] | select(.status == "fail") | "- \(.id): \(.detail)"' "$out/assessment.json"
+            } >> "$GITHUB_STEP_SUMMARY"
+          elif [ "$fresh" = "true" ]; then
+            source=$(jq -r '.storedExtras.source // "uplink/state"' "$out/assessment.json")
+            echo "Using company extras stored for the unchanged patch (${source}); not running the hook."
+            printf 'Company extras: stored for the unchanged patch (%s).\n' "$source" >> "$GITHUB_STEP_SUMMARY"
+          fi
+
+      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
+        with:
+          name: uplink-assessment
+          path: ${{ runner.temp }}/uplink-assessment/
+          if-no-files-found: error
+          overwrite: true
+
+      - name: Run company assessment hook
+        id: hook
+        if: steps.assess.outputs.ok == 'true' && steps.assess.outputs.fresh != 'true'
+        uses: $/.github/actions/uplink-assessment-hook
+        with:
+          token: ${{ secrets.GITHUB_TOKEN }}
+
+      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
+        if: steps.hook.outputs.status == 'success' || steps.hook.outputs.status == 'failure'
+        with:
+          name: uplink-packet-extras
+          path: ${{ steps.hook.outputs.dir }}/*.md
+          if-no-files-found: ignore
+          overwrite: true
+
+  # Holds uplink-mutate only to write the packet on uplink/state.
+  packet:
+    name: Write contribution packet
+    needs: assess
+    if: github.ref == 'refs/heads/main'
+    runs-on: ubuntu-latest
+    permissions:
+      contents: write
+    concurrency:
+      group: uplink-mutate
+      queue: max
+    outputs:
+      review_token: ${{ steps.packet.outputs.review_token }}
+      state_sha: ${{ steps.packet.outputs.state_sha }}
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          fetch-depth: 0
+          persist-credentials: true
+
+      - uses: $/.github/actions/install-git-uplink
+        with:
+          repo: ${{ vars.UPLINK_SRC }}
+          version: ${{ vars.UPLINK_VERSION }}
+          signer: ${{ vars.UPLINK_SIGNER }}
+          token: ${{ secrets.GITHUB_TOKEN }}
+
+      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
+        with:
+          name: uplink-assessment
+          path: ${{ runner.temp }}/uplink-assessment
+
+      # A hook that uploaded nothing leaves no artifact; the directory is then empty.
+      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
+        if: needs.assess.outputs.hook_status == 'success' || needs.assess.outputs.hook_status == 'failure'
+        continue-on-error: true
+        with:
+          name: uplink-packet-extras
+          path: ${{ runner.temp }}/uplink-packet-extras
+
+      - name: Write approver packet
+        id: packet
+        env:
+          UPLINK_INTERNAL_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          PATCH_ID: ${{ inputs.patch_id }}
+          HOOK_STATUS: ${{ needs.assess.outputs.hook_status }}
+          HOOK_RUN_URL: ${{ needs.assess.outputs.hook_run_url }}
+          ASSESSMENT: ${{ runner.temp }}/uplink-assessment/assessment.json
+          EXTRA_DIR: ${{ runner.temp }}/uplink-packet-extras
+        run: |
+          set -euo pipefail
+          git uplink init
+          # A successful hook run is stored for later packets; a failed one is
+          # not, so the next submit runs the hook again. Without a hook run,
+          # report uses the stored extras if they still match the patch.
+          # --assess-result stores the assessment the assess job made, which
+          # the hook read too. It stops when that is not for the patch as it
+          # is now (the patch, its message or uplink.toml changed since).
+          code=0
+          case "$HOOK_STATUS" in
+            success)
+              mkdir -p "$EXTRA_DIR"
+              packet=$(git uplink report "$PATCH_ID" --assess-result "$ASSESSMENT" \
+                --extra-dir "$EXTRA_DIR" --store-extras --extra-source "$HOOK_RUN_URL") || code=$?
+              ;;
+            failure)
+              mkdir -p "$EXTRA_DIR"
+              packet=$(git uplink report "$PATCH_ID" --assess-result "$ASSESSMENT" \
+                --extra-dir "$EXTRA_DIR") || code=$?
+              ;;
+            *)
+              packet=$(git uplink report "$PATCH_ID" --assess-result "$ASSESSMENT") || code=$?
+              ;;
+          esac
+          # With assessment findings report still writes the packet, then fails: publish it, then stop here so
+          # the Environment is not offered.
+          git push origin uplink/state
+          printf '%s\n' "$packet" >> "$GITHUB_STEP_SUMMARY"
+          if [ "$code" -ne 0 ]; then
+            exit "$code"
+          fi
+          # What this run asks the reviewers to approve.
+          echo "review_token=$(cat ".uplink/reports/${PATCH_ID}/review-token")" >> "$GITHUB_OUTPUT"
+          echo "state_sha=$(git rev-parse uplink/state)" >> "$GITHUB_OUTPUT"
+
+  # Do not put uplink-mutate on this job. A required-reviewer environment
+  # holds its concurrency group the whole time the job is Waiting, which
+  # would freeze import/resolve/transfer and block resolve's cancel+redispatch.
+  # preflight.sh builds and runs product code (public upstream's included),
+  # so it runs in this job: read-only token, no App token, no Environment,
+  # no credentials in the checkout. The job that holds the write tokens
+  # takes the result and never runs the script.
+  preflight:
+    name: Preflight (no credentials)
+    if: github.ref == 'refs/heads/main'
+    runs-on: ubuntu-latest
+    permissions:
+      contents: read
+    outputs:
+      report: ${{ steps.run.outputs.report }}
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          fetch-depth: 0
+          persist-credentials: false
+          ref: main
+
+      - uses: $/.github/actions/install-git-uplink
+        with:
+          repo: ${{ vars.UPLINK_SRC }}
+          version: ${{ vars.UPLINK_VERSION }}
+          signer: ${{ vars.UPLINK_SIGNER }}
+          token: ${{ secrets.GITHUB_TOKEN }}
+
+      - name: Fetch what preflight reads
+        env:
+          UPLINK_INTERNAL_TOKEN: ${{ secrets.GITHUB_TOKEN }}
