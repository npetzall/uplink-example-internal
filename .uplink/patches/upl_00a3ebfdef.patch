index 0000000000000000000000000000000000000000..60fe67f986445ba98e2c2c2dde34429d790ee2e0
--- /dev/null
+++ b/.github/actions/install-git-uplink/action.yml
@@ -0,0 +1,37 @@
+name: Install git-uplink
+description: Build git-uplink from source and put it on PATH for this runner.
+inputs:
+  src:
+    description: GitHub repository (owner/name) that contains git-uplink
+    required: true
+  rev:
+    description: Git ref to build
+    required: true
+runs:
+  using: composite
+  steps:
+    - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
+      with:
+        node-version: "22"
+    - uses: dtolnay/rust-toolchain@02cb101ec7c40f2c49e1d9714d64511d8e1b74de # v1
+      with:
+        toolchain: 1.98.1
+    - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+      with:
+        repository: ${{ inputs.src }}
+        ref: ${{ inputs.rev }}
+        path: _git-uplink-src
+        persist-credentials: false
+    - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2.9.2
+      with:
+        workspaces: _git-uplink-src
+        cache-on-failure: true
+    - name: Install git-uplink
+      shell: bash
+      run: | # zizmor: ignore[github-env] constant PATH entry for cargo --root
+        cargo install --path _git-uplink-src --locked --force --root "$HOME/.local"
+        echo "$HOME/.local/bin" >> "$GITHUB_PATH"
+        "$HOME/.local/bin/git-uplink" -h >/dev/null
+    - name: Remove source checkout
+      shell: bash
+      run: rm -rf _git-uplink-src
