@@ -0,0 +1,96 @@
+# Example copy of templates/emu-workflows/uplink-submit.yml.
+# Keep behavior in sync. This copy installs git-uplink on the runner.
+#
+# Default auth is a PAT in the oss Environment secret UPLINK_GITHUB_TOKEN
+# (vars.UPLINK_SUBMIT_AUTH=pat). That works when the contrib fork is on a
+# different GitHub owner than upstream. Set UPLINK_SUBMIT_AUTH=app and
+# fill UPLINK_APP_* secrets to mint an installation token instead
+# (production-shaped; both repos must share the App installation owner).
+name: Uplink submit
+run-name: Uplink submit ${{ inputs.patch_id }}
+
+on:
+  workflow_dispatch:
+    inputs:
+      patch_id:
+        description: Patch id to export (upl_…)
+        required: true
+
+permissions:
+  contents: write
+  deployments: write
+  pull-requests: write
+
+jobs:
+  packet:
+    name: Write OSS packet
+    if: github.ref == 'refs/heads/main'
+    runs-on: ubuntu-latest
+    concurrency:
+      group: uplink-mutate
+      cancel-in-progress: false
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+      - uses: ./.github/actions/install-git-uplink
+        with:
+          src: ${{ vars.UPLINK_SRC }}
+          rev: ${{ vars.UPLINK_REV }}
+      - uses: ./.github/actions/add-uplink-remotes
+        with:
+          upstream: ${{ vars.UPLINK_UPSTREAM }}
+          contrib: ${{ vars.UPLINK_CONTRIB }}
+      - name: Write approver packet
+        env:
+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: |
+          git fetch origin '+refs/heads/uplink/state:refs/heads/uplink/state'
+          git uplink report ${{ inputs.patch_id }}
+          git push origin uplink/state
+
+  submit:
+    name: Approve oss environment and submit
+    needs: packet
+    if: github.ref == 'refs/heads/main'
+    runs-on: ubuntu-latest
+    environment:
+      name: oss
+      url: ${{ github.server_url }}/${{ github.repository }}/blob/uplink/state/.uplink/reports/${{ inputs.patch_id }}/prepare.md
+    concurrency:
+      group: uplink-mutate
+      cancel-in-progress: false
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+          ref: main
+      - uses: ./.github/actions/install-git-uplink
+        with:
+          src: ${{ vars.UPLINK_SRC }}
+          rev: ${{ vars.UPLINK_REV }}
+      - uses: ./.github/actions/add-uplink-remotes
+        with:
+          upstream: ${{ vars.UPLINK_UPSTREAM }}
+          contrib: ${{ vars.UPLINK_CONTRIB }}
