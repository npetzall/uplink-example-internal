+++ b/.github/actions/add-uplink-remotes/action.yml
@@ -0,0 +1,24 @@
+name: Add Uplink remotes
+description: Point upstream and contrib remotes at the example GitHub repositories.
+inputs:
+  upstream:
+    description: GitHub repository (owner/name) for the public upstream
+    required: true
+  contrib:
+    description: GitHub repository (owner/name) for the contrib fork
+    required: true
+runs:
+  using: composite
+  steps:
+    - name: Add upstream and contrib remotes
+      shell: bash
+      run: |
+        if [ -z "${{ inputs.upstream }}" ] || [ -z "${{ inputs.contrib }}" ]; then
+          echo "Set repository variables UPLINK_UPSTREAM and UPLINK_CONTRIB (owner/name)." >&2
+          exit 1
+        fi
+        git remote remove upstream 2>/dev/null || true
+        git remote add upstream "https://github.com/${{ inputs.upstream }}.git"
+        git remote remove contrib 2>/dev/null || true
+        git remote add contrib "https://github.com/${{ inputs.contrib }}.git"
+        git remote -v
diff --git a/.github/actions/install-git-uplink/action.yml b/.github/actions/install-git-uplink/action.yml
new file mode 100644
index 0000000000000000000000000000000000000000..2541635e6e37d0f8989df94854f188b0375cefaf
--- /dev/null
+++ b/.github/actions/install-git-uplink/action.yml
@@ -0,0 +1,37 @@
+name: Install git-uplink
+description: Build git-uplink from source and put it on PATH for this runner.
+inputs:
+  src:
+    description: GitHub repository (owner/name) that contains git-uplink
+    required: true
+  rev:
+    description: Git ref to build
+    required: true
+runs:
+  using: composite
+  steps:
+    - uses: actions/setup-node@v4
+      with:
+        node-version: "22"
+    - uses: dtolnay/rust-toolchain@master
+      with:
+        toolchain: 1.98.1
+    - uses: actions/checkout@v4
+      with:
+        repository: ${{ inputs.src }}
+        ref: ${{ inputs.rev }}
+        path: _git-uplink-src
+        persist-credentials: false
+    - uses: Swatinem/rust-cache@v2
+      with:
+        workspaces: _git-uplink-src
+        cache-on-failure: true
+    - name: Install git-uplink
+      shell: bash
+      run: |
+        cargo install --path _git-uplink-src --locked --force --root "$HOME/.local"
+        echo "$HOME/.local/bin" >> "$GITHUB_PATH"
+        "$HOME/.local/bin/git-uplink" -h >/dev/null
+    - name: Remove source checkout
+      shell: bash
+      run: rm -rf _git-uplink-src
