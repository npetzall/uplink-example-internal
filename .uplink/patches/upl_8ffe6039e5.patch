diff --git a/.github/workflows/uplink-resolve.yml b/.github/workflows/uplink-resolve.yml
new file mode 100644
index 0000000000000000000000000000000000000000..e0156c0ad5700093a8cd20627e2c44ab1c541243
--- /dev/null
+++ b/.github/workflows/uplink-resolve.yml
@@ -0,0 +1,131 @@
+# Example copy of templates/emu-workflows/uplink-resolve.yml.
+# Keep behavior in sync. This copy installs git-uplink on the runner.
+name: Uplink resolve
+
+on:
+  push:
+    branches:
+      - "uplink/conflict/**"
+
+concurrency:
+  group: uplink-mutate
+  cancel-in-progress: false
+
+permissions:
+  contents: write
+  issues: write
+  pull-requests: write
+  actions: write
+
+jobs:
+  resolve:
+    if: github.actor != 'github-actions[bot]'
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+      - uses: ./.github/actions/install-git-uplink
+        with:
+          src: ${{ vars.UPLINK_SRC }}
+          rev: ${{ vars.UPLINK_REV }}
+      - uses: ./.github/actions/add-uplink-remotes
+        with:
+          upstream: ${{ vars.UPLINK_UPSTREAM }}
+          contrib: ${{ vars.UPLINK_CONTRIB }}
+
+      - name: Resolve patch and rebuild main
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: |
+          git fetch origin main
+          git branch -f main origin/main
+          git fetch origin '+refs/heads/uplink/upstream:refs/heads/uplink/upstream'
+          git fetch origin '+refs/heads/uplink/state:refs/heads/uplink/state'
+          id="${GITHUB_REF_NAME#uplink/conflict/}"
+          if [ -z "$id" ] || [ "$id" = "$GITHUB_REF_NAME" ]; then
+            echo "Could not parse patch id from $GITHUB_REF_NAME"
+            exit 1
+          fi
+
+          main_before=$(git rev-parse origin/main)
+
+          set +e
+          git uplink resolve "$id"
+          code=$?
+          set -e
+          if [ "$code" -ne 0 ] && [ "$code" -ne 2 ]; then
+            exit "$code"
+          fi
+
+          head=$(git rev-parse --abbrev-ref HEAD)
+          if [ "$head" != "main" ]; then
+            echo "HEAD is ${head}, not main; refusing to push"
+            exit 1
+          fi
+
+          git push origin uplink/state
+          main_after=$(git rev-parse HEAD)
+          if [ "$main_after" != "$main_before" ]; then
+            git push origin main --force-with-lease
+          fi
+
+          queue_json=$(git show uplink/state:.uplink/queue.json 2>/dev/null || cat .uplink/queue.json)
+          status=$(printf '%s\n' "$queue_json" | jq -r --arg id "$id" '.patches[] | select(.id==$id) | .status')
+          if [ "$status" = "amended" ]; then
+            waiting=$(gh run list --workflow="Uplink submit" --status=waiting --json databaseId,displayTitle,name 2>/dev/null || echo '[]')
+            echo "$waiting" | jq -r --arg id "$id" '.[] | select((.displayTitle // "" | contains($id)) or (.name // "" | contains($id))) | .databaseId' | while read -r run_id; do
+              if [ -n "$run_id" ]; then
+                gh run cancel "$run_id" || true
+              fi
+            done
+            gh workflow run "Uplink submit" --ref main -f "patch_id=$id"
+          fi
+
+          if [ "$code" -eq 2 ]; then
+            conflict_id=$(jq -r '.patches[] | select(.status=="conflict") | .id' .uplink/queue.json | head -n 1)
+            conflict_branch=$(jq -r '.patches[] | select(.status=="conflict") | .conflict.branch' .uplink/queue.json | head -n 1)
+            conflict_onto=$(jq -r '.patches[] | select(.status=="conflict") | .conflict.onto // empty' .uplink/queue.json | head -n 1)
+            if [ -z "$conflict_id" ] || [ "$conflict_id" = "null" ]; then
+              echo "resolve exited 2 but no conflict patch was recorded"
+            else
+              if git show-ref --verify --quiet "refs/heads/${conflict_branch}"; then
+                git push origin "refs/heads/${conflict_branch}:refs/heads/${conflict_branch}" --force
+              fi
+
+              title="Uplink conflict: ${conflict_id}"
+              existing=$(gh issue list --state open --json number,title --jq ".[] | select(.title==\"${title}\") | .number" | head -n 1)
+              if [ -z "$existing" ]; then
+                gh label create uplink:conflict --description "Uplink sync conflict; checkout the conflict branch, do not open a PR" --color B60205 || true
+                compare=""
+                if [ -n "$conflict_onto" ] && [ "$conflict_onto" != "null" ]; then
+                  compare="${GITHUB_SERVER_URL}/${GITHUB_REPOSITORY}/compare/${conflict_onto}...${conflict_branch}"
+                fi
+                body=$(cat <<EOF
+          Company \`main\` is bot-owned. **Do not open or merge a pull request** for this conflict.
+
+          Rebuild after resolving \`${id}\` stopped on \`${conflict_id}\`. Checkout \`${conflict_branch}\`, remove the conflict markers, and push. Then run \`git uplink resolve ${conflict_id}\` (or let **Uplink resolve** run on that push).
+
+          Remaining patches wait until this id is resolved.
+          EOF
+          )
+                if [ -n "$compare" ]; then
+                  body="${body}
+
+          Compare the failed apply (not frozen main): ${compare}"
+                fi
+                gh issue create --title "$title" --label uplink:conflict --body "$body"
+              fi
+            fi
+          fi
+
+          issue=$(gh issue list --state open --json number,title --jq ".[] | select(.title==\"Uplink conflict: ${id}\") | .number" | head -n 1)
+          if [ -n "$issue" ]; then
+            gh issue close "$issue" --comment "Resolved ${id}; company main rebuilt. Do not open a conflict PR."
+          fi
+          pr=$(gh pr list --head "$GITHUB_REF_NAME" --state open --json number --jq '.[0].number')
+          if [ -n "$pr" ]; then
+            gh pr close "$pr" --comment "Resolved ${id}; company main rebuilt. Conflicts are tracked as issues, not PRs. Do not merge a conflict PR."
+          fi
+          git push origin --delete "$GITHUB_REF_NAME"
+          exit "$code"
